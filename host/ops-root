def do_daemon_reload(req, data):
    return checked(systemctl("daemon-reload"), "systemd read its units again")


@form("enable", help="systemctl enable <service | timer | socket>")
def do_enable(req, data):
    return checked(systemctl("enable", req["args"][0]), f"{req['args'][0]} enabled")


@form("renew-certs", help="certbot renew, with no hook")
def do_renew(req, data):
    return checked(run(["certbot", "renew", "--no-random-sleep-on-renew", "--non-interactive"]), "certbot renewed")


@form("rollback", window="deploy", help="the app's own helper: /usr/local/sbin/<app>-deploy rollback")
def do_rollback(req, data):
    helper = f"/usr/local/sbin/{req['args'][0]}-deploy"
    try:
        st = os.stat(P(helper))
    except OSError:
        raise Refused(f"{helper} is not on this host") from None
    if st.st_uid != 0 or st.st_mode & 0o022 or not stat.S_ISREG(st.st_mode):
        raise Refused(f"{helper} is not a root-owned file that only root can change")
    return checked(run([helper, "rollback"]), f"{req['args'][0]} rolled back")


@form("reboot", window="reboot", reboot=True, help="reboot in 5 seconds")
def do_reboot(req, data):
    status, out = run(["systemd-run", "--on-active=5", "--unit=ops-root-reboot", "--collect", "--quiet",
                       "/usr/bin/systemctl", "reboot"])
    return checked((status, out), "the host reboots in 5 seconds")


@form("timer", help="the 600-second rollback timer: arm, cancel or status")
def do_timer(req, data):
    word = req["args"][0]
    if word == "arm":
        return arm_timer()
    if word == "cancel":
        return cancel_timer()
    status, out = systemctl("is-active", TIMER_UNIT + ".timer")
    return "armed" if out.strip() == "active" else "not armed"


@form("tailscale-upgrade", window="tailscale", reboot=True, help="upgrade Tailscale, under the rollback timer")
def do_tailscale(req, data):
    said = arm_timer()
    return said + "\n" + detached("tailscale", ["apt-get", "install", "-y", "--only-upgrade",
                                                "-o", "DPkg::Lock::Timeout=600", "tailscale"])


@form("fleet-helper", help="Fleet's root helper, from this machine's signed checkout")
def do_fleet_helper(req, data):
    kit = read(KIT_FILE).strip()
    if not kit.startswith("/") or not os.path.isfile(P(os.path.join(kit, "hubsetup.py"))):
