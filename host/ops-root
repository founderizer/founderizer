                     (f" and {len(deny['units']) - 10} more" if len(deny["units"]) > 10 else ""))
    return (out if out.strip() else "(no output)\n").rstrip("\n") + "".join(f"\n({note})" for note in notes)


@form("hide", kind="own", help="one more path that no box of this host reads, a look's and a script's: an absolute "
                               "path, added to this host's own list")
def do_hide(req, data):
    path = req["args"][0]
    lines = [line.strip() for line in read(HIDDEN_FILE).splitlines() if line.strip()]
    if path in lines or path in HIDDEN:
        return f"{path} is hidden already"
    if len(lines) >= HIDE_MAX:
        raise Refused(f"this host's own list has {HIDE_MAX} paths already")
    os.makedirs(P(ETC), mode=0o755, exist_ok=True)
    replace(HIDDEN_FILE, ("\n".join(lines + [path]) + "\n").encode(), 0o644)
    return f"{path} is hidden from now on"


def check_hide(args):
    path = one(args, "hide", "an absolute path")
    if not LOOK_SAFE.fullmatch(path) or os.path.normpath(path) != path or path.count("/") < 2 or ".." in path:
        raise Refused("hide takes one absolute path of at least two parts, of letters, digits and . _ - @ + , : = ~")
    if protected(path):
        raise Refused(f"{path} is protected on this host, and its boxes need it")
    for found in {path, real(path)}:        # the path, and where it really leads: /var/run is a link to /run
        if any(found == top or found.startswith(top + "/") or top.startswith(found + "/")
               for top in LOOK_SKIP + HIDE_NEVER + (ETC, STATE, LIB, LOOK_RUN)):
            raise Refused(f"{path} is a part of the system that every box of this host runs from, or a folder "
                          f"above one: hide takes a path of an app or of its data")
    return [path]


