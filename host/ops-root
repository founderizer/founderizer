def look_check():
    """Why this host's box does not hold, or None: one script in the box of a look that tries each way that the box
    closes, with three files of the test's own as what it must not read: one in a hidden folder, and two with a
    secret's name in folders that are not hidden, one of them a folder whose name systemd must take as one word."""
    folder, named = f"{STATE}/{LOOK_STATE}/canary", f"{LOOK_CHECK}/.env"
    odd = LOOK_CHECK + '/a b%c"d\\e/.env'        # a space, a specifier's sign, a quote and a backslash in a name
    try:
        for path, text in ((folder + "/secret", "x"), (named, "x"), (odd, "x")):
            os.makedirs(os.path.dirname(P(path)), mode=0o755, exist_ok=True)
            with open(P(path), "w") as f:
                f.write(text)
            os.chmod(P(path), 0o644)        # open to every reader: only the box keeps the look out
        status, out, _ = look_run(LOOK_TEST.replace("{folder}", folder).replace("{named}", named)
                                  .replace("{odd}", odd).encode())
    finally:
        shutil.rmtree(P(LOOK_CHECK), ignore_errors=True)
        shutil.rmtree(P(folder), ignore_errors=True)
    lines = [line.strip() for line in out.splitlines() if line.strip()]
    faults = [line for line in lines if line.startswith("FAULT")]
    if faults:
        return "; ".join(faults)[:400]
    if status != 0 or not lines or lines[-1] != "DONE 0":
        return ("the test did not run to its end: " + (" ".join(lines[-3:]) or f"status {status}"))[:400]
    return None


def look_proved():
    """None when this host's box passed its own test, for this version of this file, this boot and this systemd;
    otherwise why not. The test runs at the first look after any of the three changed, one at a time, and a pass is
    kept: a look never runs before the test passed. A test that did not pass is not kept: the next look tries the
    box again, so that one bad moment of the host does not close its looks until the next boot."""
    _, said = run(["systemctl", "--version"], timeout=30)
    key = f"{VERSION} {read(BOOT_ID).strip()} {said.splitlines()[0].strip()[:80] if said.strip() else ''}"
    os.makedirs(P(f"{STATE}/{LOOK_STATE}"), mode=0o700, exist_ok=True)
    with open(P(f"{STATE}/{LOOK_STATE}/check.lock"), "a") as lock:
        end = time.monotonic() + LOOK_WAIT
        while True:             # another first look tests the box now: a short wait, and no line of looks behind it
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.monotonic() > end:
                    raise Refused("another look tests this host's box now: send the same look again") from None
                time.sleep(0.2)
        try:
            kept = json.loads(read(f"{STATE}/{LOOK_STATE}/checked") or "{}")
        except ValueError:
            kept = {}
        if isinstance(kept, dict) and kept.get("key") == key and kept.get("passed") is True:
            return None
        why = look_check()
        if why is None:
            # this file's own folder is hidden whole, so a new file there opens nothing: no wait for a write's lock
            kept = P(f"{STATE}/{LOOK_STATE}/checked")
            with open(kept + ".new", "w") as f:
                f.write(json.dumps({"key": key, "passed": True}))
            os.replace(kept + ".new", kept)
        return why


@form("look", kind="look", write=False,
      help="a bash script that reads this host's files, in a box with no write and no network: the script on stdin "
           "with its sha256; key stores and files with a secret's name are not there; $TMPDIR is 64 MiB of room "
           "for its own files; $LOOK_CONTAINERS names the containers whose logs are at their own paths")
def do_look(req, data):
    script = script_bytes(req, data, "look")
    why = look_proved()
    if why:
        raise Refused(f"look does not run on this host: its box did not pass its own test here ({why})")
    status, out, deny = look_run(script)
    notes = []
    if status == 124 or (status != 0 and not out.strip()):
        notes.append(f"the look ended with status {status}" + (f", at its limit of {LOOK_SECONDS} seconds"
                                                               if status == 124 else ""))
    elif status != 0:
        notes.append(f"the script ended with status {status}")
    if deny["whole"]:
        notes.append("hidden whole, with all that is in them: too many files, folders or secret names, more paths to "
                     "hide than one box takes, too deep or too long a path, not readable, not reached by the list of "
                     "this host's files, or a name that no rule can write: " +
                     ", ".join(deny["whole"][:10]) +
                     (f" and {len(deny['whole']) - 10} more" if len(deny["whole"]) > 10 else ""))
