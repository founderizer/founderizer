@form("purge", kind="own", help="apt-get purge of packages by name, when apt's own dry run removes no package of "
                                "the door's way in")
def do_purge(req, data):
    status, out = run(["apt-get", "--simulate", "purge", *req["args"]], timeout=300)
    if status != 0:
        raise Failed("apt's dry run refused it:\n" + out)
    gone = [name.split(":")[0] for name in re.findall(r"^(?:Purg|Remv) (\S+)", out, re.M)]
    if not gone:
        return "nothing to purge"
    if len(gone) > PURGE_MAX:
        raise Refused(f"the purge would remove {len(gone)} packages: {PURGE_MAX} at most")
    keep = next((p for p in gone if any(fnmatch.fnmatchcase(p, k) for k in KEEP_PACKAGES)), None)
    if keep:
        raise Refused(f"the purge would remove {keep}, which the door's way in needs")
    return detached("purge", ["apt-get", "purge", "-y", "-o", "DPkg::Lock::Timeout=600", *req["args"]])


