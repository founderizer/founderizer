@form("place", help="a new value of a key where the old one is: <file> <NAME> <sha256 of the old value>, the new "
                   "value on stdin (the door's)")
def do_place(req, data):
    path, name, old = req["args"]
    value = (data or b"").decode("utf-8", "replace").strip()
    if not value or "\n" in value or len(value) > 4096:
        raise Refused("place needs the new value on stdin, one line")
    try:
        st = os.stat(P(path))
        with open(P(path), encoding="utf-8") as f:
            lines = f.read().split("\n")
    except (OSError, UnicodeDecodeError):
        raise Refused(f"{path} cannot be read here") from None
    hits = [i for i, line in enumerate(lines) if line.startswith(name + "=") and
            hashlib.sha256(line[len(name) + 1:].strip().strip('"').encode()).hexdigest() == old]
    if len(hits) != 1:
        raise Refused(f"{path} has no one line {name}= whose value has that hash: nothing was placed")
    lines[hits[0]] = f"{name}={value}"
    fd, temp = tempfile.mkstemp(dir=os.path.dirname(P(path)), prefix=".ops-root-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write("\n".join(lines))
        os.chown(temp, st.st_uid, st.st_gid)
        os.chmod(temp, stat.S_IMODE(st.st_mode))
        os.replace(temp, P(path))
    finally:
        with contextlib.suppress(OSError):
            os.remove(temp)
    return f"{name} in {path} has its new value"


def check_place(args):
