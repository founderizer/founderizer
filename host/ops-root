    token = (data or b"").decode("ascii", "replace").strip()
    if not re.fullmatch(r"[A-Z0-9]{20,100}", token):
        raise Refused("runner-register needs the registration token on stdin")
    if pristine_unit(unit):
        return reregister(req["args"][0], unit, token)
    url = read(os.path.join(folder, ".runner")).strip()
    try:
        found = json.loads(url).get("gitHubUrl")
    except ValueError:
        found = None
    if not isinstance(found, str) or not found.startswith("https://github.com/"):
        raise Refused("this runner names no GitHub address")
    user = os.stat(P(folder)).st_uid
    # the token in config.sh's environment, never in an argument, which every user of the host can read
    status, out = run(["runuser", "-u", pwd.getpwuid(user).pw_name, "--", os.path.join(folder, "config.sh"),
                       "--unattended", "--replace", "--url", found, "--name", req["args"][0]],
                      env={"ACTIONS_RUNNER_INPUT_TOKEN": token})
    return checked((status, out.replace(token, "<token>")), f"{req['args'][0]} registered")


def reregister(name, unit, token):
    """A new registration of a pristine runner (12 November 2026): one in its home would not last, because the next
    start restores the old credential files, which GitHub no longer takes. REREGISTER stops the account's runner
    units, restores the trusted state, registers with --disableupdate, records the new trusted state and starts them.
    The token goes to it on stdin and to config.sh in its environment, and no answer holds it. Each end state has its
    own exit code (the devops repository, scripts/runner/ci-runner-reregister.sh)."""
    user = unit_user(unit)
    if not pristine_account(user):
        raise Refused(f"{unit} has the pristine drop-in, and {user} has no trusted state: nothing is registered")
    if not os.access(P(REREGISTER), os.X_OK):
        raise Refused(f"{name} is a pristine runner, and {REREGISTER} is not on this host: a registration in its home "
                      f"would not last its next start")
    status, out = run([REREGISTER, user], stdin=(token + "\n").encode(), timeout=600)
    lines = out.replace(token, "<token>").strip().splitlines()
    tail = " ".join(line.strip() for line in lines[-4:])
    if status == 0:
        return lines[-1].strip() if lines else f"{name} registered"
    if status == 1:
        raise Refused(f"ci-runner-reregister refused before any change, and {name} was not touched: {tail}")
    if status == 3:
        raise Failed(f"config.sh failed: the trusted state is unchanged, and {name} runs again with its old "
                     f"registration. {tail}")
    if status == 4:
        raise Failed(f"{name} is registered at GitHub, but its new trusted state was not recorded, so its runner stays "
                     f"stopped on purpose: repair the cause, then `runner-seal {name}` records it and starts the "
                     f"runner. {tail}")
    if status == 5:
        raise Failed(f"a runner unit of {user} did not stop, or the reset before the registration failed: nothing was "
                     f"registered, and the units start again by themselves. {tail}")
    if status == 6:
        raise Failed(f"{name} is registered and its trusted state is recorded, but a runner unit of {user} did not "
                     f"start; it tries again by itself. Do not register it again: read its journal. {tail}")
    raise Failed(f"ci-runner-reregister ended with {status}, which ops-root did not expect (2 is a wrong use, a fault "
                 f"of ops-root). {tail}")


@form("runner-seal", window="restart", help="record a pristine runner's trusted state (ci-runner-reset seal) and start "
                                            "its units: the repair after a registration whose seal failed, only while "
                                            "every runner unit of its account is stopped")
def do_runner_seal(req, data):
    name = req["args"][0]
    unit = next((u for runner, u, _folder, _busy in runners() if runner == name), None)
    if unit is None:
        raise Refused(f"{name} is not a runner of this host")
    if not pristine_unit(unit):
        raise Refused(f"{name} is no pristine runner: runner-seal records only a pristine runner's trusted state")
    user = unit_user(unit)
    if not pristine_account(user):
        raise Refused(f"{user} has no trusted state: runner-seal only records a new one after ci-runner-reregister")
    if not os.access(P(CI_RESET), os.X_OK):
        raise Refused(f"{CI_RESET} is not on this host")
    status, out = run([CI_RESET, "units", user], timeout=60)
    units = [u for u in out.split() if re.fullmatch(r"actions\.runner\.[A-Za-z0-9@_.:-]+\.service", u)]
    if status != 0 or unit not in units:
        raise Failed(f"ci-runner-reset did not list the runner units of {user}: {out.strip()[-300:]}")
    going = [u for u in units if systemctl("is-active", u)[1].strip() in ("active", "activating", "deactivating",
                                                                         "reloading")]
    if going:
        raise Refused(f"{', '.join(going)} runs: runner-seal records the trusted state only while every runner unit of "
                      f"{user} is stopped, as after ci-runner-reregister ended with 4")
    status, out = run([CI_RESET, "seal", user], timeout=900)
    if status != 0:
        raise Failed(f"the seal failed, and the runner units of {user} stay stopped: {out.strip()[-500:]}")
    failed = [u for u in units if systemctl("start", "--no-block", u)[0] != 0]
    if failed:
        raise Failed(f"the trusted state of {user} is recorded, but {', '.join(failed)} did not start: read its "
                     f"journal")
    return f"the trusted state of {user} is recorded, and {', '.join(units)} started"


