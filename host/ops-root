def app_roots(app):
    return [f"{WWW}/{app}"] + [f"{d}/{app}" for d in UNIT_DIRS.values()]


def inside(path, roots):
    return os.path.normpath(path) == path and any(path == r or path.startswith(r + "/") for r in roots)


def unit_problem(app, text, port):
    """The first thing that code refuses in an app's unit, or None. systemd reads the same lines: a line that goes on
    to the next one, a section or a key that is not on the list, and a control character are refused."""
    user, current = f"{app}-app", f"{WWW}/{app}/current"
    env = f"{WWW}/{app}/shared/.env"
    if re.search(r"[\x00-\x08\x0b-\x1f\x7f]", text):
        return "the unit is plain text, with no control character"
    seen, section = {}, None
    for number, line in enumerate(text.split("\n"), 1):
        s = line.strip()
        if s.endswith("\\"):
            return f"line {number} goes on to the next line: write each setting on one line"
        if not s or s[0] in "#;":
            continue
        if s.startswith("["):
            section = s[1:-1] if s.endswith("]") else None
            if section not in UNIT_KEYS:
                return f"line {number}: an app's unit has the sections [Unit], [Service] and [Install] only"
            continue
        key, eq, value = s.partition("=")
        key, value = key.strip(), value.strip()
        if section is None or not eq:
            return f"line {number} is not a setting of a section"
        if key not in UNIT_KEYS[section]:
            return f"line {number}: {key} is not a setting that an app's unit has in [{section}]"
        seen.setdefault(key, []).append(value)
    get = lambda key: seen.get(key, [])    # noqa: E731
    if not get("User") or set(get("User")) != {user} or set(get("Group")) - {user}:
        return f"the unit runs as {user}, and as no other user or group"
    if not get("NoNewPrivileges") or set(v.lower() for v in get("NoNewPrivileges")) - set(YES):
        return "the unit has NoNewPrivileges=true"
    if env not in get("EnvironmentFile") or set(get("EnvironmentFile")) - {env, f"-{current}/.release.env"}:
        return f"the unit reads {env}, and beside it only -{current}/.release.env"
    if len(get("ExecStart")) != 1:
        return "the unit has one ExecStart"
    for key in ("ExecStart", "ExecStartPre", "ExecStartPost", "ExecReload", "ExecStop", "ExecStopPost",
                "ExecCondition"):
        for value in get(key):
            if not value.lstrip("-@:").startswith("/") or ";" in value.split():
                return f"{key} runs one program by its absolute path, with no prefix that gives it privileges"
    if not any(inside(w.strip("'\""), [current]) for w in get("ExecStart")[0].split()):
        return f"ExecStart runs the release under {current}"
    for value in get("WorkingDirectory"):
        if not inside(value.removeprefix("-"), [current]):
            return f"WorkingDirectory is {current} or a folder in it"
    for value in get("Environment"):
        try:
            words = shlex.split(value)
        except ValueError:
            return "an Environment line has a quote that does not close"
        for word in words:
            name, eq, said = word.partition("=")
            if not eq:
                return f"Environment sets NAME=value, and {word!r} is not that"
            if name == "PORT" and said != str(port):
                return f"PORT is {port}, the port of the app's settings"
            if name in ("HOST", "HOSTNAME", "BIND_HOST") and said not in LOOPBACK:
                return f"{name} is a loopback address: the app answers on this host only"
    for key in ("Wants", "Requires", "BindsTo", "PartOf"):
        for word in " ".join(get(key)).split():
            if word not in UNIT_PULLS and word != f"{app}.service" and \
                    not (word.startswith(f"{app}-") and word.endswith(".service") and UNIT.fullmatch(word)):
                return f"{key} pulls in {word}: an app's unit pulls in only the network, its database and its own units"
    for word in " ".join(get("After") + get("Before")).split():
        if not UNIT.fullmatch(word):
            return f"{word!r} is not the name of a unit"
    if not get("WantedBy") or set(" ".join(get("WantedBy")).split()) != {"multi-user.target"}:
        return "the unit is wanted by multi-user.target, and by nothing else"
    for key in UNIT_DIRS:
        for word in " ".join(get(key)).split():
            if not inside(word, [app]):
                return f"{key} is {app} or a folder in it"
    for key in ("BindPaths", "BindReadOnlyPaths"):
        for word in " ".join(get(key)).split():
            parts = word.lstrip("-").split(":")
            if len(parts) > 3 or not all(inside(p, app_roots(app)) for p in parts[:2]):
                return f"{key} binds folders of the app only: {', '.join(app_roots(app))}"
    checks = [("Type", UNIT_TYPES), ("StandardOutput", UNIT_OUTPUT), ("StandardError", UNIT_OUTPUT)]
    for key, allowed in checks:
        if set(get(key)) - set(allowed):
            return f"{key} is one of {', '.join(allowed)}"
    for key in ("StateDirectoryMode", "CacheDirectoryMode", "LogsDirectoryMode", "RuntimeDirectoryMode", "UMask"):
        if any(not re.fullmatch(r"[0-7]{3,4}", v) for v in get(key)):
            return f"{key} is an octal mode, like 0750"
    return None


def unit_folders(app, text):
    "The folders that systemd makes for the unit and gives to its user: (key, path) of each."
    out = []
    for line in text.split("\n"):
        key, eq, value = line.strip().partition("=")
        if eq and key.strip() in UNIT_DIRS:
            out += [(key.strip(), f"{UNIT_DIRS[key.strip()]}/{w}") for w in value.split()]
    return out


@form("unit-new", kind="own", help="an app's systemd unit, /etc/systemd/system/<app>.service, installed and "
                                   "enabled: <app>, the unit on stdin with its sha256, on a fix host only")
def do_unit_new(req, data):
    app = req["args"][0]
    n = app_names(app)
    if not os.path.isfile(P(n["settings"])):
        raise Refused(f"{app} is no app of this host: app-new makes it first")
    try:
        port = int(json.loads(read(n["settings"]))["port"])
        uid = pwd.getpwnam(f"{app}-app").pw_uid
    except (ValueError, TypeError, KeyError):
        raise Refused(f"{app}'s settings or its user {app}-app are not as app-new made them") from None
    if data is None or len(data) > UNIT_MAX:
        raise Refused(f"unit-new takes the unit on stdin, at most {UNIT_MAX // 1024} KiB")
    if not SHA256.fullmatch(str(req.get("sha256") or "")) or hashlib.sha256(data).hexdigest() != req["sha256"]:
        raise Refused("the bytes do not have the request's sha256")
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        raise Refused("the unit is UTF-8 text") from None
    problem = unit_problem(app, text, port)
    if problem:
        raise Refused(problem)
    unit = f"{app}.service"
    taken = [p for p in (n["unit"], f"/etc/systemd/system/{unit}.d", f"/run/systemd/system/{unit}.d")
             if os.path.lexists(P(p))]
    if taken or unit_known(unit):
        raise Refused(f"{', '.join(taken) or unit} exists already: unit-new installs a new unit only")
    for key, path in unit_folders(app, text):
        with contextlib.suppress(FileNotFoundError):
            if os.lstat(P(path)).st_uid != uid:
                raise Refused(f"{path} of {key} exists and is not {app}-app's: systemd would give it to the app")
    replace(n["unit"], data, 0o644)
    try:
        checked(systemctl("daemon-reload"), None)
        checked(systemctl("enable", unit), None)
    except Failed as e:
        with contextlib.suppress(OSError):
            os.remove(P(n["unit"]))
        systemctl("daemon-reload")
        raise Failed(f"unit-new stopped, and it took the unit back: {e}") from None
    return f"{unit} is installed and enabled: the app's first release starts it"


def add_setting(req, data):
    app, name, source = req["args"]
    n = app_names(app)
    if not os.path.isfile(P(n["settings"])):
        raise Refused(f"{app} is no app of this host: app-new makes it first")
    try:
        value = (data or b"").decode("utf-8")
    except UnicodeDecodeError:
        raise Refused("the value is UTF-8 text") from None
    if not value or len(value) > VALUE_MAX or re.search(r"[\x00-\x1f\x7f]", value):
        raise Refused(f"the value comes on stdin, one line of at most {VALUE_MAX} characters")
    try:
        st = os.lstat(P(n["env"]))
        with open(P(n["env"]), encoding="utf-8") as f:
            text = f.read()
    except (OSError, UnicodeDecodeError):
        raise Refused(f"{n['env']} cannot be read here: app-new makes it") from None
    if not stat.S_ISREG(st.st_mode) or stat.S_IMODE(st.st_mode) != 0o600 or (os.geteuid() == 0 and st.st_uid != 0):
        raise Refused(f"{n['env']} is not root's file of mode 0600: app-check says what is wrong")
    for line in text.split("\n"):
        s = line.strip()
        if s and s[0] not in "#;" and s.partition("=")[0].strip() == name:
            raise Refused(f"{name} is in {app}'s settings already: a new value of a key goes where the old one is")
    if not VALUE_PLAIN.fullmatch(value):        # systemd's own quotes: a backslash keeps \ " ` and $ as they are
        value = '"' + re.sub(r'([\\"`$])', r"\\\1", value) + '"'
    replace(n["env"], (text + ("\n" if text and not text.endswith("\n") else "") + f"{name}={value}\n").encode(), 0o600)
    said = "32 random bytes of the door" if source == "random" else f"the key that the owner saved as app:{app}:{name}"
    return f"{name} is in {app}'s settings, from {said}: the app reads it when it next starts"


@form("env-new", help="a new setting in an app's settings file, before its first release: <app> <NAME> random|key, "
                      "the value on stdin (the door's), on a fix host only")
def do_env_new(req, data):
    if os.path.lexists(P(f"{WWW}/{req['args'][0]}/current")):
        raise Refused(f"{req['args'][0]} has a release: env-add adds a setting now, as the agent's own call")
    return add_setting(req, data)


@form("env-add", kind="own", help="a new setting in an app's settings file, after its first release: <app> <NAME> "
                                  "random|key, the value on stdin (the door's), on a fix host only")
def do_env_add(req, data):
    return add_setting(req, data)


# ---- the app's runner (new-projects plan N6)
#
# runner-new <app> makes the app's own GitHub runner as its deploy user: the door sends a registration token and a
# remove token of the repository that it made for the app, the repository's address, the runner's name and the
# runner's latest release with the SHA-256 that GitHub publishes for each archive, all on stdin. Root downloads the
# archive and checks it, the deploy user unpacks it from root's stream and registers it, with the token in
# ACTIONS_RUNNER_INPUT_TOKEN and never in an argument, and root writes the unit itself. Nothing in the runner's folder
# runs as root. A step that fails after the registration takes it back with the remove token, so a retry can run.

RUNNER_MAX = 512 * 1024 * 1024          # bytes of the runner's archive
RUNNER_ARCH = {"x86_64": "x64", "aarch64": "arm64"}
RUNNER_RELEASES = "https://github.com/actions/runner/releases/download"
RUNNER_TOKEN = re.compile(r"[A-Z0-9]{20,100}")


def machine():
    return os.uname().machine


def runner_folder(app):
    return f"/home/{app}-deploy/actions-runner"


def runner_input(data):
    "The door's JSON on stdin, checked: {token, remove, url, name, version, sha256: {x64, arm64}}."
    try:
        got = json.loads(data or b"")
        ok = isinstance(got, dict) and set(got) == {"token", "remove", "url", "name", "version", "sha256"} and \
            all(isinstance(got[k], str) and RUNNER_TOKEN.fullmatch(got[k]) for k in ("token", "remove")) and \
            re.fullmatch(r"https://github\.com/[A-Za-z0-9-]{1,39}/[A-Za-z0-9._-]{1,100}", str(got["url"])) and \
            re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]{0,63}", str(got["name"])) and \
            re.fullmatch(r"[0-9]{1,3}\.[0-9]{1,4}\.[0-9]{1,4}", str(got["version"])) and \
            isinstance(got["sha256"], dict) and set(got["sha256"]) == set(RUNNER_ARCH.values()) and \
            all(isinstance(v, str) and SHA256.fullmatch(v) for v in got["sha256"].values())
    except (ValueError, TypeError, RecursionError):
        ok = False
    if not ok:
        raise Refused("runner-new needs the door's tokens, the repository and the runner's release on stdin")
    return got


def fetch(url, path, limit):
    """The bytes at url into path (root's own file), with their SHA-256; at most limit bytes."""
    digest, size = hashlib.sha256(), 0
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(urllib.request.Request(url, headers={"User-Agent": "ops-root"}), timeout=120) as r, \
                open(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "wb") as f:
            while True:
                chunk = r.read(1024 * 1024)
                if not chunk:
                    break
                size += len(chunk)
                if size > limit:
                    raise Refused(f"the runner's archive is over {limit // 1024 ** 2} MiB")
                digest.update(chunk)
                f.write(chunk)
    except (OSError, urllib.error.URLError) as e:
        raise Failed(f"the runner's archive did not download: {e}") from None
    return digest.hexdigest()


@form("runner-new", help="the app's own GitHub runner, as its deploy user: <app>, the door's tokens and the runner's "
                         "release on stdin (the door's), on a fix host only")
def do_runner_new(req, data):
    app = req["args"][0]
    if pristine_account(f"{app}-deploy"):
        raise Refused(f"{app}-deploy is a pristine runner account, whose runner the devops repository's install makes: "
                      f"runner-new makes none there")
    n, given = app_names(app), runner_input(data)
    user, folder = f"{app}-deploy", runner_folder(app)
    if not os.path.isfile(P(n["settings"])):
        raise Refused(f"{app} is no app of this host: app-new makes it first")
    try:
        pw = pwd.getpwnam(user)
    except KeyError:
        raise Refused(f"{user} is not a user here: app-new makes it") from None
    arch = RUNNER_ARCH.get(machine())
    if arch is None:
        raise Refused(f"the runner has no archive for {machine()}")
    scope = re.sub(r"[^A-Za-z0-9_-]", "-", given["url"].removeprefix("https://github.com/").replace("/", "-"))
    unit = f"actions.runner.{scope}.{given['name']}.service"
    if not UNIT.fullmatch(unit):
        raise Refused(f"{unit} is not a unit's name")
    taken = [p for p in (folder, f"/etc/systemd/system/{unit}") if os.path.lexists(P(p))] + \
        [u for _, u, _, _ in runners() if u.endswith(f".{given['name']}.service")]
    if taken:
        raise Refused(f"{', '.join(taken)} exists already: runner-new makes the app's one runner")
    if "libicuuc.so" not in run(["ldconfig", "-p"], timeout=60)[1]:
        raise Refused("the runner needs ICU, which this host lacks: the install form installs its libicu first")
    secrets = (given["token"], given["remove"])

    def as_user(*argv, token=None, stdin=None):
        env = {"ACTIONS_RUNNER_INPUT_TOKEN": token} if token else None
        status, out = run(["runuser", "-u", user, "--", *argv], stdin=stdin, timeout=900, env=env)
        for secret in secrets:
            out = out.replace(secret, "<token>")
        return status, out

    archive = P(f"{STATE}/runner-{app}.tar.gz")
    registered = False
    try:
        os.makedirs(os.path.dirname(archive), exist_ok=True)
        name = f"actions-runner-linux-{arch}-{given['version']}.tar.gz"
        if fetch(f"{RUNNER_RELEASES}/v{given['version']}/{name}", archive, RUNNER_MAX) != given["sha256"][arch]:
            raise Refused(f"{name} does not have the SHA-256 that GitHub publishes with it")
        os.mkdir(P(folder), 0o750)
        if os.geteuid() == 0:
            os.chown(P(folder), pw.pw_uid, pw.pw_gid)
        os.chmod(P(folder), 0o750)
        with open(archive, "rb") as stream:     # the deploy user unpacks the bytes that root checked, from root's stream
            checked(as_user("tar", "-xzf", "-", "-C", folder, "--no-same-owner", stdin=stream), None)
        registered = True
        checked(as_user(f"{folder}/config.sh", "--unattended", "--url", given["url"], "--name", given["name"],
                        "--labels", app, "--work", "_work", token=given["token"]), None)
        checked(as_user("cp", f"{folder}/bin/runsvc.sh", f"{folder}/runsvc.sh"), None)
        replace(f"/etc/systemd/system/{unit}", (
            f"[Unit]\nDescription=GitHub Actions Runner ({scope}.{given['name']})\nAfter=network-online.target\n"
            f"Wants=network-online.target\n\n[Service]\nExecStart={folder}/runsvc.sh\nUser={user}\n"
            f"WorkingDirectory={folder}\nKillMode=process\nKillSignal=SIGTERM\nTimeoutStopSec=5min\n\n"
            f"[Install]\nWantedBy=multi-user.target\n").encode(), 0o644)
        checked(systemctl("daemon-reload"), None)
        checked(systemctl("enable", "--now", unit), None)
    except (Refused, Failed, OSError) as e:
        if registered:
            as_user(f"{folder}/config.sh", "remove", token=given["remove"])
        with contextlib.suppress(OSError):
            os.remove(P(f"/etc/systemd/system/{unit}"))
        systemctl("daemon-reload")
        shutil.rmtree(P(folder), ignore_errors=True)
        said = str(e)
        for secret in secrets:
            said = said.replace(secret, "<token>")
        raise (Refused if isinstance(e, Refused) else Failed)(
            f"runner-new stopped, and it took back what it made: {said}") from None
    finally:
        with contextlib.suppress(OSError):
            os.remove(archive)
    return f"{given['name']} runs as {user} ({unit}), with the labels self-hosted, linux, {arch} and {app}"


# ---- the app's vhost (new-projects plan N7)
#
# vhost-new <app> installs /etc/nginx/sites-available/<app> and its link in sites-enabled, as the agent's own call, once
# code has read it. It holds server blocks only. It listens only on 127.0.0.1 and [::1], at one port of its own that is
# not 80, 443 or the app's own port, and that no listener and no other app has. No other vhost serves its server_name.
# It sends requests only to the app's own port on loopback, serves files only from the app's own tree, includes only
# nginx's own snippets, and writes logs only to /var/log/nginx, because nginx opens those files as root. nginx -t must
# pass with no warning that was not there before, and nginx reloads. The two folders' immutable bit goes back as it was
# in a finally block, and a step that fails takes the vhost back, so nginx stays as it was. The tunnel then sends the
# app's hostname to that port (cloudflare tunnel-route).

NGINX = "/etc/nginx"
VHOST_MAX = 64 * 1024
VHOST_REFUSED = ("fastcgi_pass", "uwsgi_pass", "scgi_pass", "grpc_pass", "memcached_pass", "proxy_store",
                 "load_module", "include_by_lua", "perl", "perl_modules", "perl_require", "js_import", "js_include",
                 "js_path", "js_content", "js_set", "upstream", "map", "geo", "split_clients")
VHOST_PATHS = ("client_body_temp_path", "proxy_temp_path", "fastcgi_temp_path", "uwsgi_temp_path",
               "scgi_temp_path", "auth_basic_user_file", "ssl_certificate", "ssl_certificate_key",
               "ssl_trusted_certificate", "ssl_client_certificate", "ssl_dhparam", "ssl_password_file")
VHOST_TOKEN = re.compile(r'#[^\n]*|"(?:[^"\\]|\\.)*"|\'(?:[^\'\\]|\\.)*\'|[{};]|[^\s{};"\']+')
HOSTNAME = re.compile(r"(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}")


def nginx_directives(text):
    """[(name, args, blocks)] of every directive of an nginx text, at any depth, where blocks names the blocks that
    hold it; None when its braces or semicolons do not close. Quotes are taken off the arguments."""
    out, words, stack = [], [], []
    for token in VHOST_TOKEN.findall(text):
        if token.startswith("#"):
            continue
        if token in (";", "{"):
            if not words:
                return None
            out.append((words[0], [w[1:-1] if w[:1] in "\"'" else w for w in words[1:]], tuple(stack)))
            if token == "{":
                stack.append(words[0])
            words = []
        elif token == "}":
            if words or not stack:
                return None
            stack.pop()
        else:
            words.append(token)
    return out if not words and not stack else None


def vhost_problem(app, text, port):
    """(problem, vhost port, server names): the first thing that code refuses in an app's vhost, or None."""
    directives = nginx_directives(text)
    if directives is None or re.search(r"[\x00-\x08\x0b-\x1f\x7f]", text):
        return "the vhost does not parse: each directive ends with ; and each block closes", None, []
    tree, ports, names = f"{WWW}/{app}", set(), []
    for name, args, blocks in directives:
        if not blocks and name != "server":
            return f"the vhost holds server blocks only, and {name} is not one", None, []
        if name in VHOST_REFUSED or name.startswith(("perl", "js_", "lua_")) or "_by_lua" in name:
            return f"{name} is not a directive of an app's vhost", None, []
        if any("$" in a for a in args) and name in ("proxy_pass", "root", "alias", "include", "access_log",
                                                     "error_log", *VHOST_PATHS):
            return f"{name} names its target with no variable", None, []
        if name == "listen":
            found = re.fullmatch(r"(127\.0\.0\.1|\[::1\]):([1-9][0-9]{0,4})", args[0]) if len(args) == 1 else None
            if not found:
                return "the vhost listens only on 127.0.0.1:<port> and [::1]:<port>, with nothing more", None, []
            ports.add(int(found.group(2)))
        elif name == "server_name":
            names += args
        elif name == "proxy_pass":
            if len(args) != 1 or not re.fullmatch(rf"http://(127\.0\.0\.1|\[::1\]|localhost):{port}(/[^\s]*)?",
                                                  args[0]):
                return f"proxy_pass sends requests only to the app's own port, http://127.0.0.1:{port}", None, []
        elif name in ("root", "alias"):
            if len(args) != 1 or os.path.normpath(args[0]) != args[0].rstrip("/") or \
                    not (args[0] + "/").startswith(tree + "/"):
                return f"{name} serves files from {tree} only", None, []
        elif name == "include":
            if len(args) != 1 or not (args[0] in (f"{NGINX}/proxy_params", f"{NGINX}/mime.types") or
                                      re.fullmatch(rf"{NGINX}/snippets/[A-Za-z0-9._-]+\.conf", args[0])):
                return "include takes nginx's own proxy_params, mime.types or a file of its snippets", None, []
        elif name in ("access_log", "error_log"):
            if not args or not (args[0] == "off" or re.fullmatch(r"/var/log/nginx/[A-Za-z0-9._-]+", args[0])):
                return f"{name} writes to /var/log/nginx only, or is off", None, []
        elif name in VHOST_PATHS:
            return f"{name} names a file that nginx opens as root, which an app's vhost does not", None, []
    if len(ports) != 1:
        return "the vhost listens on one port of its own, on 127.0.0.1 and [::1]", None, []
    vport = ports.pop()
    if vport in (80, 443, port) or not 1024 <= vport <= 65535:
        return (f"the vhost's port is a port of its own from 1024 to 65535: never 80, 443 or the app's own port "
                f"{port}"), None, []
    hostnames = [n.lower() for n in names if n != "_"]
    if not hostnames or not all(HOSTNAME.fullmatch(n) for n in hostnames):
        return "server_name names the app's hostnames, like app.example.com", None, []
    return None, vport, hostnames


def served_names(skip):
    "The server_name of every other vhost that nginx reads: sites-enabled and conf.d."
    names = set()
    for folder, pattern in ((f"{NGINX}/sites-enabled", "*"), (f"{NGINX}/conf.d", "*.conf")):
        with contextlib.suppress(OSError):
            for entry in sorted(os.listdir(P(folder))):
                if entry == skip or not fnmatch.fnmatchcase(entry, pattern):
                    continue
                for name, args, _ in nginx_directives(read(f"{folder}/{entry}")) or []:
                    if name == "server_name":
                        names |= {a.lower() for a in args}
    return names


def immutable(path):
    "True when the folder has its immutable bit (lsattr -d), which a write must lift first and set back after."
    status, out = run(["lsattr", "-d", P(path)], timeout=30)
    return status == 0 and "i" in (out.split() or [""])[0]


def nginx_warnings():
    "(status, output, the warning lines) of nginx -t."
    status, out = run(["nginx", "-t"], timeout=120)
    return status, out, {line.strip() for line in out.splitlines() if "[warn]" in line or "[emerg]" in line}


@form("vhost-new", kind="own", window="restart", help="an app's nginx vhost on a loopback port of its own: <app>, "
                                                      "the vhost on stdin with its sha256, on a fix host only")
def do_vhost_new(req, data):
    app = req["args"][0]
    n = app_names(app)
    try:
        settings = json.loads(read(n["settings"]))
        port = int(settings["port"])
    except (ValueError, TypeError, KeyError):
        raise Refused(f"{app} is no app of this host: app-new makes it first") from None
    if data is None or len(data) > VHOST_MAX:
        raise Refused(f"vhost-new takes the vhost on stdin, at most {VHOST_MAX // 1024} KiB")
    if not SHA256.fullmatch(str(req.get("sha256") or "")) or hashlib.sha256(data).hexdigest() != req["sha256"]:
        raise Refused("the bytes do not have the request's sha256")
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        raise Refused("the vhost is UTF-8 text") from None
    problem, vport, hostnames = vhost_problem(app, text, port)
    if problem:
        raise Refused(problem)
    available, enabled = f"{NGINX}/sites-available/{app}", f"{NGINX}/sites-enabled/{app}"
    if os.path.lexists(P(available)) or os.path.lexists(P(enabled)) or "vhost_port" in settings:
        raise Refused(f"{app} has a vhost already: vhost-new installs a new one only")
    if vport in ports_taken():
        raise Refused(f"something listens on port {vport}, or another app has it")
    taken = sorted(set(hostnames) & served_names(app))
    if taken:
        raise Refused(f"another vhost serves {taken[0]} already")
    status, out, before = nginx_warnings()
    if status != 0:
        raise Refused("nginx -t fails before this vhost, so nothing is installed:\n" + out[-2000:])
    folders = [f"{NGINX}/sites-available", f"{NGINX}/sites-enabled"]
    held = [f for f in folders if immutable(f)]
    made = []
    try:
        for folder in held:
            checked(run(["chattr", "-i", P(folder)], timeout=30), None)
        replace(available, data, 0o644)
        made.append(available)
        os.symlink(available, P(enabled))
        made.append(enabled)
        status, out, after = nginx_warnings()
        if status != 0 or after - before:
            raise Refused("nginx -t did not pass with no new warning, and the vhost is taken back:\n" + out[-2000:])
        replace(n["settings"], (json.dumps(dict(settings, vhost_port=vport), sort_keys=True) + "\n").encode(),
                0o644)
        made.append("settings")
        checked(systemctl("reload", "nginx"), None)
    except (Refused, Failed, OSError) as e:
        if "settings" in made:
            replace(n["settings"], (json.dumps(settings, sort_keys=True) + "\n").encode(), 0o644)
        for path in reversed([p for p in made if p != "settings"]):
            with contextlib.suppress(OSError):
                os.remove(P(path))
        if isinstance(e, Refused):
            raise
        raise Failed(f"vhost-new stopped, and it took the vhost back: {e}") from None
    finally:
        for folder in held:
            run(["chattr", "+i", P(folder)], timeout=30)
    return (f"{app}'s vhost serves {', '.join(hostnames)} on 127.0.0.1:{vport} and [::1]:{vport}: "
            f"tunnel-route sends the hostname there")

# ---------------------------------------------------------------- what the forms share

def checked(result, done):
    status, out = result
    if status != 0:
        raise Failed(out.strip() or f"it ended with status {status}")
    return done if done is not None else out


def detached(name, argv):
    """A long step that must outlive the session: a transient service that the session only watches. If the session
    ends, the step goes on to its end, and the next call reads what it did in the journal."""
    unit = f"ops-root-{name}-{int(time.time())}"
    # --no-block: systemd-run returns once the start is queued, where a oneshot unit would hold it to its very end. A
    # unit that ended well is unloaded by itself, and one that failed stays failed until reset-failed below.
    status, out = run(["systemd-run", "--no-block", "--unit", unit, "--quiet", "--property=Type=oneshot",
                       "--property=TimeoutStartSec=3600", *(f"--setenv={k}={v}" for k, v in ENV.items()), "--",
                       *argv], timeout=60)
    if status != 0:
        raise Failed(out.strip() or "systemd-run could not start it")
    while True:
        time.sleep(2)
        status, out = run(["systemctl", "show", "--property=ActiveState,Result", unit + ".service"], timeout=30)
        states = dict(line.split("=", 1) for line in out.splitlines() if "=" in line)
        if states.get("ActiveState") not in ("activating", "active", "reloading", "deactivating"):
            break
    _, log = run(["journalctl", "--no-pager", "-o", "cat", "-n", "200", "-u", unit + ".service"], timeout=60)
    if states.get("ActiveState") == "failed" or states.get("Result") not in ("success", None):
        run(["systemctl", "reset-failed", unit + ".service"], timeout=30)
        raise Failed(f"{name} failed ({states.get('Result')}):\n{log[-4000:]}")
    return f"{name} done\n{log[-4000:]}"


def hidden_paths():
    extra = [line.strip() for line in read(HIDDEN_FILE).splitlines() if line.strip().startswith("/")]
    return sorted(set(HIDDEN) | {os.path.normpath(p) for p in extra if ".." not in p})


def file_digest(path):
    try:
        with open(P(path), "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()
    except OSError:
        return None


def remember_yes(path, digest, other, said):
    """A yes of same or covers, for drop: the file's digest, the other file, which holds what it holds, and the form
    that said so. drop checks all three again."""
    yes = json.loads(read(STATE + "/yes.json", "{}") or "{}")
    yes[path] = {"digest": digest, "other": other, "form": said}
    if len(yes) > 1000:
        yes = dict(list(yes.items())[-1000:])
    write_state("yes.json", json.dumps(yes))


def write_state(name, text):
    os.makedirs(P(STATE), mode=0o700, exist_ok=True)
    replace(os.path.join(STATE, name), text.encode(), 0o600)


def replace(path, data, mode_bits):
    """A file's new bytes, put in its place by a rename, when no look runs (look_writes): a rename opens a file again
    that a look's box hides by itself."""
    with look_writes():
        fd, temp = tempfile.mkstemp(dir=os.path.dirname(P(path)), prefix=".ops-root-")
        try:
            with os.fdopen(fd, "wb") as f:
                f.write(data)
            os.chmod(temp, mode_bits)
            os.replace(temp, P(path))
        finally:
            with contextlib.suppress(OSError):
                os.remove(temp)


def runners():
    """[(name, unit, folder, busy)] of the GitHub runners' units here: actions.runner.<...>.<name>.service."""
    status, out = systemctl("list-units", "--all", "--plain", "--no-legend", "actions.runner.*")
    found = []
    for line in out.splitlines() if status == 0 else []:
        unit = line.split()[0] if line.split() else ""
        if not unit.startswith("actions.runner.") or not unit.endswith(".service"):
            continue
        name = unit[:-len(".service")].rsplit(".", 1)[-1]
        _, shown = systemctl("show", "--property=WorkingDirectory,MainPID", unit)
        props = dict(l.split("=", 1) for l in shown.splitlines() if "=" in l)
        pid, folder = props.get("MainPID", "0"), props.get("WorkingDirectory", "")
        _, tree = run(["ps", "-o", "comm=", "--ppid", pid]) if pid.isdigit() and pid != "0" else (0, "")
        busy = "Runner.Worker" in tree or any("Runner.Worker" in line for line in run(
            ["pgrep", "-a", "-f", "Runner.Worker"])[1].splitlines() if folder and folder in line)
        found.append((name, unit, folder, busy))
    return found


def ci_layout():
    """(runner user, build file) of a CI host whose runners are containers of a rootless Docker on a sparse ext4 file
    (E50): what install.sh's --runner-user and --build-file named, and on a host whose install named neither, what the
    host itself shows. That is the one user other than root whose rootless Docker runs and keeps its data on the
    mounted ext4 file system of a loop device, and that device's file. The app's install names neither, and a host
    keeps the settings of its install, so before this no host of that layout grew its build file or restarted a runner
    container by a rule call. ("", "") on every other host: Docker on the host's own disk, no rootless Docker, or more
    than one such user."""
    if "found" not in LAYOUT:
        LAYOUT["found"] = find_layout()
    return LAYOUT["found"]


def find_layout():
    named = (read(RUNNER_USER_FILE).strip(), read(BUILD_FILE).strip())
    if any(named):
        return named
    status, out = run(["findmnt", "--list", "--noheadings", "--types", "ext4", "--output", "SOURCE"])
    loops = {word for word in out.split() if re.fullmatch(r"/dev/loop[0-9]{1,4}", word)} if status == 0 else set()
    found = []
    for user in rootless_users() if loops else []:
        if pristine_account(user):      # its runner is a unit, and root restores its home before each job
            continue
        status, out = rootless_as(user, "info", "--format", "{{.DockerRootDir}}", timeout=30)
        roots = [line.strip() for line in out.splitlines() if line.strip().startswith("/")]   # a warning is no path
        root = roots[0] if len(roots) == 1 else ""
        if status != 0 or not root or os.path.normpath(root) != root:
            continue
        status, out = run(["findmnt", "--noheadings", "--output", "SOURCE", "--target", root])
        if status != 0 or out.strip() not in loops:
            continue
        status, out = run(["losetup", "--noheadings", "--output", "BACK-FILE", out.strip()])
        path = out.strip()
        if status == 0 and path.startswith("/") and os.path.normpath(path) == path:
            found.append((user, path))
    return found[0] if len(found) == 1 else ("", "")


def rootless_users():
    """The users other than root whose rootless Docker runs: each one's socket /run/user/<uid>/docker.sock, its own."""
    users = []
    try:
        entries = sorted(os.listdir(P("/run/user")))
    except OSError:
        return users
    for entry in entries:
        if not re.fullmatch(r"[1-9][0-9]{0,9}", entry):
            continue
        try:
            st = os.stat(P(f"/run/user/{entry}/docker.sock"))
            name = pwd.getpwuid(int(entry)).pw_name
        except (OSError, KeyError):
            continue
        if stat.S_ISSOCK(st.st_mode) and st.st_uid == int(entry) and re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", name):
            users.append(name)
    return users


def rootless_as(user, *words, timeout=300):
    """(status, output) of docker in one user's rootless daemon, as that user."""
    try:
        pw = pwd.getpwnam(user) if re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", user) else None
    except KeyError:
        pw = None
    if pw is None or pw.pw_uid == 0:
        raise Refused("this host names no rootless runner user")
    runtime = f"/run/user/{pw.pw_uid}"
    return run(["runuser", "-u", user, "--", "env", f"HOME={pw.pw_dir}", f"XDG_RUNTIME_DIR={runtime}",
                f"DOCKER_HOST=unix://{runtime}/docker.sock", "docker", *words], timeout=timeout)


def rootless(*words, timeout=300):
    """(status, output) of docker in the runner user's rootless daemon, as that user."""
    return rootless_as(ci_layout()[0], *words, timeout=timeout)


def container_runners():
    """[(name, state, busy)] of the runner containers: every container of the runner user's rootless daemon. A host
    that has no runner user has none."""
    if not ci_layout()[0]:
        return []
    status, out = rootless("ps", "--all", "--format", "{{.Names}}\t{{.State}}")
    if status != 0:
        raise Failed("the runners' rootless Docker does not answer: " + out.strip()[-300:])
    found = []
    for line in out.splitlines():
        name, _, state = line.partition("\t")
        if RUNNER.fullmatch(name):
            busy = state == "running" and rootless("exec", name, "pgrep", "-f", "Runner.Worker", timeout=60)[0] == 0
            found.append((name, state, busy))
    return found


def network_back(name):
    """A full disk lost a container's saved network once, and Docker started it with no endpoint: a runner with no
    eth0 cannot reach GitHub. Such a container on the default bridge is connected to it again."""
    status, out = rootless("inspect", "--format", "{{.HostConfig.NetworkMode}} "
                           "{{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}", name)
    words = out.split()
    if status != 0:
        return f", but its network could not be read: {out.strip()[-200:]}"
    if not words or words[0] not in ("bridge", "default") or len(words) > 1:
        return ""
    checked(rootless("network", "connect", "bridge", name), None)
    return ", and its lost network is back"


def idle_runner(name):
    for runner, unit, folder, busy in runners():
        if runner == name:
            if busy:
                raise Refused(f"{name} runs a job now: only an idle runner")
            if not folder.startswith("/"):
                raise Refused(f"{name} names no folder")
            return unit, folder
    raise Refused(f"{name} is not a runner of this host")


# ---- the rollback timer
#
# The timer is a transient unit, and a transient unit does not outlive a reboot (nor a soft reboot, which keeps the
# boot id), while ufw applies its files again at boot. So a lockout whose countdown a reboot cut short stayed for good.
# While a countdown runs, the rollback folder holds the mark ARMED, and BOOT_UNIT runs `--boot` at each boot: a mark
# whose timer runs no more is a countdown that the reboot ended, and it fires, as that timer would have.

ARMED = STATE + "/rollback/armed"           # a countdown runs: written before its timer starts, gone with the folder

BOOT_TEXT = f"""[Unit]
Description=ops-root: the rollback whose timer a reboot ended
ConditionPathExists={ARMED}
ConditionFileIsExecutable={SELF}
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={SELF} --boot

[Install]
WantedBy=multi-user.target
"""


def boot_unit():
    """BOOT_UNIT in place and enabled, at each arm: a self-update brings this file and no unit, and only an arm leaves
    a snapshot that a boot could find. An arm whose unit is not in place fails, and the change after it does not run."""
    path = "/etc/systemd/system/" + BOOT_UNIT
    try:
        if read(path) != BOOT_TEXT:
            os.makedirs(os.path.dirname(P(path)), exist_ok=True)
            replace(path, BOOT_TEXT.encode(), 0o644)
            checked(systemctl("daemon-reload"), None)
        if systemctl("is-enabled", BOOT_UNIT)[1].strip() != "enabled":
            checked(systemctl("enable", BOOT_UNIT), None)
    except (Failed, OSError) as e:
        raise Failed(f"the rollback timer could not put {BOOT_UNIT} in place: {e}") from None


def countdown_lost():
    """A countdown ran (its mark, which no cancel and no fire removed) and its timer runs no more."""
    return os.path.isfile(P(ARMED)) and systemctl("is-active", TIMER_UNIT + ".timer")[1].strip() != "active"


def at_boot():
    """At each boot, from BOOT_UNIT: a countdown that the reboot ended fires now, as its timer would have; one that an
    arm of this boot started runs on. The check comes again under the host's lock, which no write of an earlier boot
    holds: an arm of this boot takes its snapshot before the check or after the fire, never while the old files go
    back. While a countdown runs it takes no lock, so a start of the unit then waits for nothing."""
    if not countdown_lost():
        return
    os.makedirs(os.path.dirname(P(LOCK_FILE)) or "/", exist_ok=True)
    with open(P(LOCK_FILE), "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if countdown_lost():
            whole = fire()
            print("the reboot ended a rollback countdown: " + ("the files are back as at its first arm" if whole else
                                                              "tar could not put every file back"))


def arm_timer():
    """Save sshd's files and every path that arms the timer (SNAPSHOT), which of them are absent, and the Tailscale
    version as they are now, and start the timer that puts them back in ROLLBACK_AFTER seconds unless `timer cancel`
    comes first; BOOT_UNIT and the mark ARMED before that, so that a reboot in the countdown puts them back too.
    Armed again before a cancel or the fire, in the same boot: the countdown starts again, and the files and the
    version stay those of the first arm. A firewall file arms it, and so does the `ufw` or `nft` that applies that
    file, so a new snapshot at each arm would keep the very change that locked the door out, and the timer would put
    that back; a start of the timer that failed does not make the next arm take a new one either. After a boot the
    host runs every file it has, and the arm came through the door, so the next arm takes a new snapshot."""
    boot_unit()
    folder = P(STATE + "/rollback")
    snapshot = os.path.join(folder, "snapshot.tar")
    boot = read(BOOT_ID).strip()
    kept = bool(boot) and os.path.isfile(snapshot) and read(STATE + "/rollback/boot").strip() == boot
    try:
        if not kept:
            os.makedirs(folder, mode=0o700, exist_ok=True)
            present = [p for p in SNAPSHOT if os.path.lexists(P(p))]
            status, out = run(["tar", "-C", P("/") or "/", "-cpf", snapshot, *[p.lstrip("/") for p in present]])
            if status != 0:
                raise Failed("the rollback timer could not save the files it restores: " + out)
            with open(os.path.join(folder, "snapshot.json"), "w") as f:      # what a fire removes: restore()
                json.dump({"sha256": file_digest(STATE + "/rollback/snapshot.tar"),
                           "absent": [p for p in SNAPSHOT if p not in present]}, f)
            _, version = run(["dpkg-query", "-W", "-f=${Version}", "tailscale"])
            with open(os.path.join(folder, "tailscale"), "w") as f:
                f.write(version.strip() if re.fullmatch(r"[A-Za-z0-9.+~:-]{1,60}", version.strip()) else "")
            with open(os.path.join(folder, "boot"), "w") as f:
                f.write(boot + "\n")
        open(P(ARMED), "w").close()
        systemctl("stop", TIMER_UNIT + ".timer")
        status, out = run(["systemd-run", f"--on-active={ROLLBACK_AFTER}", f"--unit={TIMER_UNIT}", "--collect",
                           "--quiet", SELF, "--fire"])
        if status != 0:
            raise Failed("the rollback timer could not start: " + out)
    except Failed:
        # A first arm that did not start: the change it came before does not run, so its snapshot guards nothing and
        # must not stay for the rest of the boot. A later arm's snapshot stays: a change of the first one is in place.
        # But no countdown runs now, so no boot fires it either.
        if not kept:
            shutil.rmtree(folder, ignore_errors=True)
        else:
            with contextlib.suppress(OSError):
                os.remove(P(ARMED))
        raise
    return f"the rollback timer is armed: in {ROLLBACK_AFTER} seconds it restores the firewall, the network, sshd " \
           f"and Tailscale" + (" as they were at its first arm" if kept else "")


def cancel_timer():
    """The countdown ends and its change stays. With no snapshot left, the answer says so: a fire or a boot may have
    put the files back before this cancel came."""
    systemctl("stop", TIMER_UNIT + ".timer")
    waited = os.path.isdir(P(STATE + "/rollback"))
    shutil.rmtree(P(STATE + "/rollback"), ignore_errors=True)
    return "the rollback timer is off" if waited else \
        "the rollback timer is off, and no snapshot waited: its fire or a boot put the files back, or nothing armed it"


def fire():
    """The timer fired, or a boot found a countdown that the reboot ended: systemd's failed states first (one past
    revert failed on the start limit), then the files exactly as at the first arm, and what applies them. systemd reads
    its units again (a tailscaled drop-in, and sshd's socket from its Port), and netplan applies when its files changed.
    sshd restarts, by its socket since Ubuntu 24.04, and then the firewall: nftables first, as its restart flushes
    every rule; ufw, whose own restart skips a ufw that its file says is not enabled, so a changed ufw.conf stops it
    first; netfilter-persistent only when /etc/iptables changed, as its start replaces whole tables, Docker's too. Then
    the Tailscale version, as its downgrade can need the network, and Tailscale and the door's own sshd after it. True
    when tar put every file back."""
    folder = P(STATE + "/rollback")
    snapshot = os.path.join(folder, "snapshot.tar")
    run(["systemctl", "reset-failed"])
    applied = ("/etc/netplan", "/etc/ufw/ufw.conf", "/etc/iptables")
    before = [tree_state(p) for p in applied]
    with look_away(LOOK_SECONDS + 10):      # tar and a package's downgrade put files back as new files: no look
        #                                    runs beside them, by a wait that never waits for a form that writes
        whole = restore(snapshot) if os.path.isfile(snapshot) else True
        netplan, ufw, iptables = (tree_state(p) != b for p, b in zip(applied, before))
        systemctl("daemon-reload")
        if netplan:
            with contextlib.suppress(OSError):
                run(["netplan", "apply"])
        restart("ssh.service", "ssh.socket", "nftables.service")
        if ufw:
            with contextlib.suppress(OSError):
                run([UFW_INIT, "force-stop"])
        restart("ufw.service")
        if iptables:
            restart("netfilter-persistent.service")
        version = read(STATE + "/rollback/tailscale").strip()
        if version:
            _, now = run(["dpkg-query", "-W", "-f=${Version}", "tailscale"])
            if now.strip() != version:
                run(["apt-get", "install", "-y", "--allow-downgrades", "-o", "DPkg::Lock::Timeout=600",
                     f"tailscale={version}"], timeout=1800)
    restart("tailscaled.service", SSHD_UNIT)
    with contextlib.suppress(OSError):
        run(["ufw", "reload"])
    shutil.rmtree(folder, ignore_errors=True)
    return whole


def restart(*units):
    for unit in units:
        if systemctl("is-enabled", unit)[1].strip() in ("enabled", "static"):
            systemctl("restart", unit)


def restore(snapshot):
    """Each path of SNAPSHOT exactly as at the arm. tar puts back what the snapshot holds and keeps what came later, so
    first go: each path that was absent at the arm, each entry of a saved folder that the snapshot does not hold, and
    each entry whose kind changed (a folder where it has a file, or the other way round). Only a snapshot with the
    digest of its arm removes anything: a crash can cut one short, and an older ops-root saved fewer paths and wrote
    no digest. tar puts back what any snapshot holds. True when it put every file back."""
    try:
        listed = json.loads(read(STATE + "/rollback/snapshot.json"))
        if listed["sha256"] != file_digest(STATE + "/rollback/snapshot.tar"):
            raise ValueError("not the snapshot of its arm")
        absent = [p for p in listed["absent"] if p in SNAPSHOT]
        with tarfile.open(snapshot) as archive:
            kinds = {os.path.normpath(m.name).lstrip("/"): m.isdir() for m in archive.getmembers()}
    except (OSError, ValueError, KeyError, TypeError, tarfile.TarError):
        absent, kinds = [], {}
    for path in SNAPSHOT:
        if path in absent or path.lstrip("/") in kinds:
            with contextlib.suppress(RecursionError):       # Python 3.12's rmtree, in a folder 1000 deep
                prune(path, kinds)
    status, out = run(["tar", "-C", P("/") or "/", "-xpf", snapshot])
    if status != 0:
        print("the rollback's tar could not put every file back: " + out.strip()[-1000:])
    return status == 0


def prune(path, kinds):
    """What of `path` the snapshot does not hold goes (kinds: each name that it holds, and whether that is a folder),
    a package's file too: one that a package put there in the countdown can hold the door's own edit, and a lockout
    that a fire keeps is worse than a conffile that dpkg must put back (--force-confmiss). Never through a link: a
    link goes as a link, and only a real folder is gone through."""
    todo = [path]
    while todo:
        path = todo.pop()
        full = P(path)
        folder = os.path.isdir(full) and not os.path.islink(full)
        if kinds.get(path.lstrip("/")) == folder:
            if folder:
                with contextlib.suppress(OSError):
                    todo += [path + "/" + name for name in os.listdir(full)]
        elif folder:
            shutil.rmtree(full, ignore_errors=True)
        else:
            with contextlib.suppress(OSError):
                os.remove(full)


def tree_state(path):
    """Each entry of `path` with its kind, mode, owner and bytes (a link's target, and a file larger than FILE_MAX by
    its size and time), never through a link: two readings differ when something there changed."""
    found, todo = [], [path]
    while todo:
        path = todo.pop()
        full = P(path)
        try:
            st = os.lstat(full)
        except OSError:
            continue
        extra = None
        with contextlib.suppress(OSError):
            if stat.S_ISLNK(st.st_mode):
                extra = os.readlink(full)
            elif stat.S_ISREG(st.st_mode):
                extra = file_digest(path) if st.st_size <= FILE_MAX else (st.st_size, int(st.st_mtime))
            elif stat.S_ISDIR(st.st_mode):
                todo += [path + "/" + name for name in sorted(os.listdir(full), reverse=True)]
        found.append((path, st.st_mode, st.st_uid, st.st_gid, extra))
    return found


# ---- a signed bundle from a release

def release_keys():
    """The keys of both files: a fleet that takes releases early runs a release that the early key signed. A file that
    is not read whole gives no key, as releases.parse_keys reads one."""
    return file_keys(KEY_FILE) + file_keys(EARLY_FILE)


def file_keys(path):
    keys = []
    for line in read(path).splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            try:
                key = base64.b64decode(line, validate=True)
            except ValueError:
                return []
            if len(key) != 32:
                return []
            keys.append(key)
    return keys[:4]


def signed_text(m):
    return b"\n".join([b"founderizer-release-1", m["revision"].encode(), m["version"].encode(),
                       (m.get("notes") or "").encode(), (m.get("minimum") or "").encode(),
                       b"true" if m.get("hold") else b"false"]) + b"\n"


def git_object(kind, body):
    return hashlib.sha1(kind.encode() + b" " + str(len(body)).encode() + b"\0" + body).hexdigest()


def tree_entries(body):
    """{name: (mode, sha1)} of a raw git tree object."""
    entries, i = {}, 0
    while i < len(body):
        space, nul = body.index(b" ", i), body.index(b"\0", i)
        mode_bits, name = body[i:space].decode(), body[space + 1:nul].decode("utf-8", "replace")
        entries[name] = (mode_bits, body[nul + 1:nul + 21].hex())
        i = nul + 21
    return entries


def verify_bundle(bundle):
    """{name: bytes} of the host files in a bundle that a release key signed. The bundle carries the release's
    manifest, its commit object, the root tree, the tree of host/ and each file: each object's git hash is checked
    from the signed revision down, so the bytes are those of host/<name> at that release, or nothing is taken."""
    try:
        m = bundle["manifest"]
        signature = base64.b64decode(m["signature"] + "=" * (-len(m["signature"]) % 4))
        commit, root, folder = (base64.b64decode(bundle[k]) for k in ("commit", "root", "host"))
        files = {k: base64.b64decode(v) for k, v in bundle["files"].items()}
        if not re.fullmatch(r"[0-9a-f]{40}", m["revision"]) or not isinstance(m["version"], str):
            raise ValueError
    except (KeyError, TypeError, ValueError, AttributeError):
        raise Refused("the release bundle is not well formed") from None
    if not any(verify_signature(key, signed_text(m), signature) for key in release_keys()):
        raise Refused("no release key of this host signed this release")
    if git_object("commit", commit) != m["revision"]:
        raise Refused("the commit is not the signed revision")
    tree = re.match(rb"tree ([0-9a-f]{40})\n", commit)
    if not tree or git_object("tree", root) != tree.group(1).decode():
        raise Refused("the root tree is not the signed revision's")
    host = tree_entries(root).get("host")
    if not host or git_object("tree", folder) != host[1]:
        raise Refused("host/ is not the signed revision's")
    listed = tree_entries(folder)
    for name, body in files.items():
        if name not in ("ops-root", "ops-read", "inventory", "app-release") or listed.get(name, ("", ""))[1] != \
                git_object("blob", body):
            raise Refused(f"host/{name} is not the signed revision's")
    if "ops-root" not in files:
        raise Refused("the bundle carries no ops-root")
    return files


def descends(bundle, floor):
    """True when the signed revision is the floor or comes after it, the door's own rule (git merge-base
    --is-ancestor) without a repository: the bundle's `history` carries raw commits below the revision, each taken
    by its own hash, so the way down goes only through the parents that those commits name."""
    revision, history = bundle["manifest"]["revision"], bundle.get("history") or []
    try:
        if not isinstance(history, list):
            raise ValueError
        known = {git_object("commit", body): body for body in (base64.b64decode(one) for one in history)}
    except (TypeError, ValueError):
        raise Refused("the release bundle is not well formed") from None
    known[revision] = base64.b64decode(bundle["commit"])
    todo, seen = [revision], set()
    while todo:
        sha = todo.pop()
        if sha == floor:
            return True
        if sha in seen or sha not in known:
            continue
        seen.add(sha)
        head = known[sha].split(b"\n\n", 1)[0]
        todo += [p.decode() for p in re.findall(rb"^parent ([0-9a-f]{40})$", head, re.M)]
    return False


# Ed25519 (RFC 8032), verify only: the same code as releases.py, here so that this file stands alone.
_P = 2 ** 255 - 19
_Q = 2 ** 252 + 27742317777372353535851937790883648493


def _inv(x):
    return pow(x, _P - 2, _P)


_D = -121665 * _inv(121666) % _P
_SQRT_M1 = pow(2, (_P - 1) // 4, _P)


def _recover_x(y, sign):
    if y >= _P:
        return None
    x2 = (y * y - 1) * _inv(_D * y * y + 1) % _P
    if x2 == 0:
        return None if sign else 0
    x = pow(x2, (_P + 3) // 8, _P)
    if (x * x - x2) % _P != 0:
        x = x * _SQRT_M1 % _P
    if (x * x - x2) % _P != 0:
        return None
    if (x & 1) != sign:
        x = _P - x
    return x


def _add(a, b):
    p = (a[1] - a[0]) * (b[1] - b[0]) % _P
    q = (a[1] + a[0]) * (b[1] + b[0]) % _P
    r = 2 * a[3] * b[3] * _D % _P
    s = 2 * a[2] * b[2] % _P
    e, f, g, h = q - p, s - r, s + r, q + p
    return (e * f % _P, g * h % _P, f * g % _P, e * h % _P)


def _mul(n, point):
    found = (0, 1, 1, 0)
    while n > 0:
        if n & 1:
            found = _add(found, point)
        point = _add(point, point)
        n >>= 1
    return found


def _same(a, b):
    return (a[0] * b[2] - b[0] * a[2]) % _P == 0 and (a[1] * b[2] - b[1] * a[2]) % _P == 0


_GY = 4 * _inv(5) % _P
_GX = _recover_x(_GY, 0)
_G = (_GX, _GY, 1, _GX * _GY % _P)


def _decompress(blob):
    if len(blob) != 32:
        return None
    y = int.from_bytes(blob, "little")
    sign, y = y >> 255, y & ((1 << 255) - 1)
    x = _recover_x(y, sign)
    return None if x is None else (x, y, 1, x * y % _P)


def verify_signature(public, message, signature):
    if not (isinstance(public, bytes) and len(public) == 32 and isinstance(signature, bytes) and len(signature) == 64):
        return False
    try:
        point, given = _decompress(public), _decompress(signature[:32])
        scalar = int.from_bytes(signature[32:], "little")
        if point is None or given is None or scalar >= _Q or point[0] % _P == 0 or \
                not _same(_mul(_Q, point), (0, 1, 1, 0)):
            return False
        h = int.from_bytes(hashlib.sha512(signature[:32] + public + message).digest(), "little") % _Q
        return _same(_mul(scalar, _G), _add(given, _mul(h, point)))
    except (ValueError, TypeError, OverflowError):
        return False


# ---------------------------------------------------------------- one call

def decode(text):
    try:
        req = json.loads(base64.b64decode(text, validate=True))
    except (ValueError, TypeError):
        raise Refused("the request is not base64 JSON") from None
    if not isinstance(req, dict) or req.get("v") != 1 or not isinstance(req.get("op"), str):
        raise Refused("the request is not {v: 1, op, args}")
    req.setdefault("args", [])
    return req


def call(req, data=None):
    """The answer to one request, as text; Refused or Failed otherwise."""
    LAYOUT.clear()
    op = req["op"]
    req["args"] = check_args(op, req["args"])
    f = FORMS[op]
    if f["kind"] in ("own", "full", "look") and mode() != "fix":
        raise Refused("this host is rule-only: only rule forms run here, and no file install")
    if op in PLAN_WRITES and mode() != "fix":        # new-projects plan N4: a new app lives on a fix host only
        raise Refused("this host is rule-only: no form of a new app writes here")
    if data is not None and op not in ("file", "self-update", "pro-attach", "runner-register", "place", "unit-new",
                                       "env-new", "env-add", "runner-new", "vhost-new", "script", "run", "look"):
        raise Refused(f"{op} takes nothing on stdin")
    if not f["write"]:
        return f["run"](req, data)
    os.makedirs(os.path.dirname(P(LOCK_FILE)) or "/", exist_ok=True)
    with open(P(LOCK_FILE), "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)         # a second write on this host waits here
        if op in LOOK_WRITERS:      # no look runs beside a form that runs a program of another's making
            with look_writes():
                return f["run"](req, data)
        return f["run"](req, data)


def main(argv):
    if len(argv) == 2 and argv[1] in ("--fire", "--boot"):
        if os.getppid() != 1:
            print(f"refused: {argv[1]} is the rollback timer's own")
            return 3
        if argv[1] == "--fire":
            fire()
        else:
            at_boot()
        return 0
    try:
        if len(argv) != 2:
            raise Refused("ops-root takes one argument: the request")
        req = decode(argv[1])
        data = None if sys.stdin is None or sys.stdin.isatty() else sys.stdin.buffer.read(FILE_MAX * 2 + 1) or None
        print(call(req, data)[-(LOOK_OUT if req.get("op") == "look" else OUT_MAX):])
        return 0
    except Refused as e:
        print(f"refused: {e}"[:2000])
        return 3
    except Failed as e:
        print(f"failed: {e}"[-OUT_MAX:])
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
