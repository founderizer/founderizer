# ---- the agent's own forms: a host in fix mode only

def box(unit):
    """systemd-run's argv for one transient service in the box of exec and script: the host's app trees and secret
    paths hidden, the protected paths read-only, and the kernel rights dropped that would open them again (DevOps
    plan, "The host login"). The agent's own copies go to BACKUPS, which the box writes and only root reads: systemd
    makes it for the service, as its state folder, and names it in $STATE_DIRECTORY."""
    props = ["PrivateDevices=yes", "NoNewPrivileges=yes", "ProtectKernelModules=yes", "ProtectKernelTunables=yes",
             "ProtectControlGroups=yes", "RestrictSUIDSGID=yes", "LockPersonality=yes",
             "CapabilityBoundingSet=~" + " ".join(CAPS_DROPPED),
             "StateDirectory=" + BACKUPS.removeprefix("/var/lib/"), "StateDirectoryMode=0700"]
    props += [f"InaccessiblePaths=-{p}" for p in hidden_paths()]
    props += [f"ReadOnlyPaths=-{p.rstrip('/')}" for p in PROTECTED]
    argv = ["systemd-run", "--pipe", "--wait", "--collect", "--quiet", "--unit", unit]
    for p in props:
        argv += ["--property", p]
    return argv


@form("exec", kind="own", window="restart", help=f"one command, no shell, in the box: a service that hides the app "
                                                 f"trees, where copies go to {BACKUPS}")
def do_exec(req, data):
    args = req["args"]
    said = ""
    if os.path.basename(args[0]) in TIMED_PROGRAMS:
        said = arm_timer() + "\n"
    status, out = run(box(f"ops-root-exec-{os.getpid()}") + ["--", *args])
    return said + checked((status, out), out or "done")


def script_bytes(req, data, name):
    """A script's bytes from stdin, which have the request's sha256: text for bash, with no NUL byte."""
    if not data or len(data) > SCRIPT_MAX:
        raise Refused(f"{name} takes the script on stdin, at most {SCRIPT_MAX // 1024} KiB")
    if not SHA256.fullmatch(str(req.get("sha256") or "")) or hashlib.sha256(data).hexdigest() != req["sha256"]:
        raise Refused("the bytes do not have the request's sha256")
    if b"\0" in data:
        raise Refused(f"the script of {name} is text for bash, with no NUL byte")
    return data


def run_script(name, req, data, boxed):
    """A bash script from stdin, in a transient service of its own: in the box for script, as root with no box for
    run. The rollback timer is armed first, whatever the script does, because no code reads in a script whether it
    changes the firewall, the network or sshd; the door ends the countdown when the host answers it after the script,
    and a host that does not answer gets them back. The script's file is in this file's own folder, which the box reads
    and never writes, and it goes when the script ends."""
    data = script_bytes(req, data, name)
    said = arm_timer() + "\n"
    path, unit = f"{STATE}/{name}-{os.getpid()}.sh", f"ops-root-{name}-{os.getpid()}"
    os.makedirs(os.path.dirname(P(path)), mode=0o700, exist_ok=True)
    with contextlib.suppress(FileNotFoundError):
        os.remove(P(path))
    try:
        with open(os.open(P(path), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o700), "wb") as f:
            f.write(data)
        argv = box(unit) if boxed else ["systemd-run", "--pipe", "--wait", "--collect", "--quiet", "--unit", unit]
        status, out = run(argv + [f"--setenv={k}={v}" for k, v in ENV.items()] + ["--", "/bin/bash", path],
                          timeout=SCRIPT_WAIT)
    finally:
        with contextlib.suppress(OSError):
            os.remove(P(path))
    if status != 0:
        raise Failed(said + (out.strip() or f"the script ended with status {status}"))
    return said + (out or "done")


@form("script", kind="own", window="restart", help="a bash script in the box of exec, under the rollback timer: the "
                                                   "script on stdin with its sha256; pipes, loops and flock work")
def do_script(req, data):
    return run_script("script", req, data, boxed=True)


# ---- what the next mode allows: the door sends it only with the owner's signed yes to that exact call

@form("run", kind="full", window="restart", help="a bash script as root with no box, under the rollback timer: the "
                                                 "script on stdin with its sha256; the door sends it only with the "
                                                 "owner's yes to that exact call, on a fix host only")
def do_run(req, data):
    return run_script("run", req, data, boxed=False)


