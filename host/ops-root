def look_mounts():
    """{mount point: file system} of this host, from its own table."""
    out = {}
    for line in read("/proc/self/mounts").splitlines():
        parts = line.split(" ")
        if len(parts) >= 3 and parts[1].startswith("/"):
            out[parts[1].replace("\\040", " ")] = parts[2]
    return out


LOOK_SPECIFIERS = {"%E": "/etc", "%t": "/run", "%S": "/var/lib", "%C": "/var/cache", "%L": "/var/log", "%h": "/root",
                   "%%": "%"}


def look_units():
    """(paths, unit files): the files that a unit of this host names as its settings or its credentials
    (EnvironmentFile=, LoadCredential=), and the unit files written on this host that hold a value themselves
    (Environment=, SetCredential=), which are hidden too. A unit file that is a link (systemctl link) is read where
    it leads, and that file is the one that is hidden."""
    paths, own = [], []
    for top in LOOK_UNITS:
        for folder, _folders, files in os.walk(P(top)):
            for name in sorted(files):
                full = os.path.join(folder, name)
                if not name.endswith(LOOK_UNIT_ENDS) or not os.path.isfile(full):
                    continue
                try:
                    with open(full, encoding="utf-8", errors="replace") as f:
                        text = f.read(256 * 1024)
                except OSError:
                    continue
                holds = False
                for line in text.replace("\\\n", " ").splitlines():      # a line that goes on after a backslash
                    key, _, value = line.strip().partition("=")
                    key, value = key.strip(), value.strip()
                    if key == "EnvironmentFile":
                        paths += look_named(value.lstrip("-"))
                    elif key in ("LoadCredential", "LoadCredentialEncrypted"):
                        paths += look_named(value.partition(":")[2])
                    elif key in ("Environment", "SetCredential", "SetCredentialEncrypted") and value:
                        holds = True
                listed = full[len(ROOT):] if ROOT else full
                shown = real(listed) if os.path.islink(full) else listed       # where a link really leads
                if holds and listed.startswith(tuple(t + "/" for t in LOOK_OWN_UNITS)):
                    paths.append(shown)
                    own.append(shown)
    return paths, own


def look_named(path):
    """The files that a unit's path names: the path itself, without its quotes, or what it matches when it has a
    specifier that this file does not know (%i, %p)."""
    path = path.strip()
    if len(path) > 1 and path[0] == path[-1] and path[0] in "\"'":
        path = path[1:-1]
    for sign, folder in LOOK_SPECIFIERS.items():
        path = path.replace(sign, folder if sign != "%%" else "\0")
    if not path.startswith("/"):
        return []
    path = os.path.normpath(path)
    if "%" not in path:
        return [path.replace("\0", "%")]
    import glob
    pattern = re.sub(r"%.", "*", glob.escape(P(path)).replace("[%]", "%")).replace("\0", "[%]")
    return [(p[len(ROOT):] if ROOT else p) for p in sorted(glob.glob(pattern))[:LOOK_MATCHES]]


def look_homes():
    """The dot entries of the home of each account of this host: its keys, its histories and its tools' logins."""
    paths = []
    for line in read("/etc/passwd").splitlines():
        parts = line.split(":")
        home = os.path.normpath(parts[5]) if len(parts) > 5 and parts[5].startswith("/") else None
        if not home or home in LOOK_NO_HOME:
            continue
        try:
            with os.scandir(P(home)) as entries:
                dots = sorted(e.name for e in entries if e.name.startswith(".") and not e.is_symlink())
        except OSError:
            continue
        paths += [home + "/" + name for name in dots[:LOOK_HOME]]
        if len(dots) > LOOK_HOME:
            paths.append(home)
    return paths


def look_names(known):
    """(paths, whole): the files with a secret's name and the folders with a store's name, on each file system of this
    host that is a disk of its own, found by one walk that follows no link. `known`: what is hidden already, which is
    not walked. A file system of another machine is hidden and not walked. whole: the folders that are hidden whole
    because they hold more such names than LOOK_MATCHES, more folders than LOOK_FOLDERS or more entries than
    LOOK_ENTRIES, because they are too deep or could not be read, or because the walk ended before it read them:
    the answer of a look names them.

    A folder that the walk does not read to its end is in the paths, each one: only what LOOK_SKIP and
    LOOK_UNSEARCHED name, a file system that is no disk, and a link are left unread and open.

    The walk reads the folders nearest to the top first, each level before the next one. When its count, its time or
    the paths that it holds end it, the folders that it had not read are hidden: those of the level that it was at,
    and the ones below. That can be an app's own folders of that level, on a server with more files than one look
    lists. It is never the top of the server for one mass of files in one folder."""
    mounts, found, whole, left = look_mounts(), [], [], LOOK_WALK
    queue = collections.deque(["/"] + [p for p in LOOK_NOT_SKIPPED if p not in known])
    skip = (set(LOOK_SKIP) | set(LOOK_UNSEARCHED) | set(known)) - set(LOOK_NOT_SKIPPED)
    end = time.monotonic() + LOOK_LIST_SECONDS
    while queue:
        folder = queue.popleft()
        if folder.count("/") > LOOK_DEPTH or len(folder) > LOOK_LONG:
            found.append(folder)        # too deep, or a path that is too long: hidden, and not read
            whole.append(folder)
            continue
        try:
            with os.scandir(P(folder)) as it:       # at most one entry more than a folder may have: no list of a
                entries = list(itertools.islice(it, LOOK_ENTRIES + 1))      # million names is ever made
        except OSError as e:
            if folder == "/":
                raise Refused("this host's top folder could not be read to know what a look must not read") from None
            if e.errno not in (errno.ENOENT, errno.ENOTDIR):    # it is there, and it could not be read: hidden
                found.append(folder)
                whole.append(folder)
            continue
        left -= len(entries) + 1
        if left < 0 or len(queue) + len(found) > LOOK_QUEUE or time.monotonic() > end:
            # the count or the time is spent, or the walk holds too many paths: this folder and each one that
            # still waits go whole
            rest = [folder] + list(queue)
            if "/" in rest:             # before the walk read anything: there is no list, so there is no look
                raise Refused("this host's files could not be read in time to know what a look must not read")
            return found + rest, whole + rest
        if len(entries) > LOOK_ENTRIES:     # a mass of files, whose names were not all read
            if folder == "/":           # the names after the cut are folders that nothing would hide
                raise Refused("this host's top folder has more entries than a look reads the names of: no look "
                              "runs here")
            found.append(folder)
            whole.append(folder)
            continue
        entries.sort(key=lambda e: e.name)
        folders = {e.name for e in entries if e.is_dir(follow_symlinks=False)}
        if folder != "/" and (any(e.name in LOOK_DATA for e in entries) or
                              any(engine <= folders for engine in LOOK_ENGINES)):
            found.append(folder)        # a database's own folder, or a container engine's
            continue
        matches, later = [], []
        for e in entries:
            path = folder.rstrip("/") + "/" + e.name
            if e.is_symlink() or path in skip:
                continue
            low = e.name.lower()
            if e.name in folders:
                kind = mounts.get(path, "")
                if LOOK_NETWORK.fullmatch(kind) or low in LOOK_DIRS or low.startswith(LOOK_DIR_STARTS):
                    matches.append(path)
                elif kind not in LOOK_PSEUDO or path in LOOK_NOT_SKIPPED:
                    later.append(path)
            elif LOOK_NAME.match(low) or (low == "config.php" and folder.endswith("/bootstrap/cache")):
                matches.append(path)
        if (len(later) > LOOK_FOLDERS and folder != "/") or (len(matches) > LOOK_MATCHES and folder.count("/") >= 2):
            found.append(folder)        # a mass of folders, none of which is read; or a store of keys
            whole.append(folder)
        else:
            found += matches
            queue.extend(later)
    return found, whole


def look_docker():
    """(Docker's folder, its containers' log files, "<id>=<name>" of each): the folder is hidden whole behind an empty
    one, and each container's log is bound back at its own path, so that a container that starts during a look shows
    nothing of its settings."""
    root = "/var/lib/docker"
    try:
        conf = json.loads(read("/etc/docker/daemon.json") or "{}")
        named = conf.get("data-root") or conf.get("graph") if isinstance(conf, dict) else None
    except ValueError:
        named = None
    if isinstance(named, str) and LOOK_SAFE.fullmatch(named) and ".." not in named:
        root = os.path.normpath(named)
    logs, names = [], []
    try:
        ids = sorted(os.listdir(P(root + "/containers")))
    except OSError:
        return (root if os.path.isdir(P(root)) else None), [], []
    for cid in [c for c in ids if SHA256.fullmatch(c)][:LOOK_CONTAINERS]:
        log = f"{root}/containers/{cid}/{cid}-json.log"
        if not plain(log):
            continue
        logs.append(log)
        try:
            name = json.loads(read(f"{root}/containers/{cid}/config.v2.json") or "{}").get("Name")
        except (ValueError, AttributeError):
            name = None
        names.append(f"{cid[:12]}={re.sub(r'[^A-Za-z0-9_.-]', '', str(name or ''))[:60]}")
    return root, logs, names


def look_fewer(paths, limit, never=()):
    """(paths, whole): at most `limit` of them, by hiding whole folders in place of the paths under them. No path of
    `paths` is under another one. The list never fails for its size: a host with more secret names than a unit can
    hide loses the sight of the folders that hold them. `never`: the parts of the system that a box runs from. No
    folder at one of them or above one goes whole (/etc, /var, /run, /dev), because the box would not start or
    would see no system: a host whose paths fit in no other way gets no look.

    Which folders. A path's levels are counted from the first folder above it that may go whole: /srv, /var/www and
    /var/lib/<app> are each level 0, and an app's folder in /srv or /var/www is level 1. Hiding every folder of
    level 0 leaves the fewest paths that any choice can, so when that is too many, nothing fits. Else the rule takes
    the level nearest to the files at which hiding every folder with paths under it would be enough, and hides at
    that level the folders with the most paths first, only as many as it takes; of such a folder it hides the
    narrowest folder that holds the same paths. After each one the level is looked for again, because with a mass
    gone a level nearer to the files can be enough: it never goes back up. So one folder with thousands of names
    goes whole alone, and no small app beside it goes with it (on 14 November 2026 a pass for each depth, the
    deepest first, hid an app's folder for its three names before it came to the mass)."""
    paths, whole = set(paths), []
    if len(paths) <= limit:
        return sorted(paths), whole
    held = set(never) | {top[:i] for top in never for i, c in enumerate(top) if c == "/" and i}
    ends = {}           # of a path: where each folder that may go whole in its place ends, the top one first

    def above(path):
        if path not in ends:
            cuts = [i for i, c in enumerate(path) if c == "/"][1:]
            first = next((n for n, i in enumerate(cuts) if path[:i] not in held), len(cuts))
            ends[path] = cuts[first:]
        return ends[path]
    # under: the paths below a folder. folders: for each level, the folders with a path below them. at: for each
    # level, the paths whose own place is that level; at[0] is the paths that no folder can stand for.
    under, folders, at = {}, collections.Counter(), collections.Counter()

    def count(path, by):
        at[len(above(path))] += by
        for level, cut in enumerate(above(path)):
            folder = path[:cut]
            had = under.get(folder, 0)
            under[folder] = had + by
            if (had == 0) != (had + by == 0):
                folders[level] += 1 if had == 0 else -1

    for path in paths:
        count(path, 1)
    deepest = max(at)

    def enough():
        """The deepest level at which hiding each folder with paths under it leaves at most `limit` paths, or
        None: a path at that level or above it stays as it is, and each deeper one is under a folder of the level."""
        found, stay = None, 0
        for level in range(deepest + 1):
            stay += at[level]
            if folders[level] + stay <= limit:
                found = level
        return found

    while len(paths) > limit:
        level = enough()
        if level is None:       # more paths right under / than a unit hides, or in folders that a box runs from
            raise Refused(f"this host has more than {limit} paths to hide, and no folders of its apps that could "
                          f"be hidden whole in their place: no look runs here")
        groups = {}
        for path in paths:
            if len(above(path)) > level:
                groups.setdefault(path[:above(path)[level]], []).append(path)
        before = len(paths)
        for folder, members in sorted(groups.items(), key=lambda g: (-len(g[1]), g[0])):
            if len(members) < 2:
                break
            folder = os.path.commonpath(members)        # the narrowest folder that holds them all: at it or below
            for path in members:
                count(path, -1)
            paths.difference_update(members)
            paths.add(folder)
            count(folder, 1)
            whole.append(folder)
            if len(paths) <= limit or enough() != level:
                break
        if len(paths) == before:    # no folder of that level holds two paths: cannot be, and never a loop
            raise Refused(f"this host has more than {limit} paths to hide, and no folders of its apps that could "
                          f"be hidden whole in their place: no look runs here")
    return sorted(paths), [folder for folder in whole if folder in paths]


def look_deny():
    """{"paths", "whole", "units", "docker", "logs", "containers"}: what one look does not read, made for that look."""
    docker, logs, containers = look_docker()
    fixed = [p for p in tuple(LOOK_KEYS) + tuple(hidden_paths()) if p not in ("/var/www", "/srv", "/opt", "/home")]
    declared, units = look_units()
    homes = look_homes()                # hidden here, so the walk does not read them: a tool's cache in a home
    #                                     holds 65,536 folders at one level
    names, whole = look_names(set(fixed) | set(homes) | ({docker} if docker else set()))
    hidden = fixed + declared + homes + names
    # A Python file's compiled copy holds what the file holds, and the walk hides no cache folder by its name:
    # beside a hidden .py file, its folder's cache and an old .pyc or .pyo are hidden too. That covers a file that
    # only this host's own list or a unit names. It does not cover the cache beside a link to the file, or a cache
    # folder that Python's own settings name (SECURITY.md).
    for path in [p for p in hidden if p.endswith(".py")]:
        hidden += [copy for copy in (os.path.dirname(path) + "/__pycache__", path + "c", path + "o")
                   if os.path.lexists(P(copy))]
    safe = set()
    for path in hidden:
        path = os.path.normpath(path)
        named = path
        while path != "/" and LOOK_NEVER.search(path):      # a name that no property of a unit takes: its folder
            path = os.path.dirname(path)
        if path != "/" and path != docker and not (docker and path.startswith(docker + "/")):
            safe.add(path)
            if path != named:
                whole.append(path)
    # a path under a folder that is hidden already says nothing more
    paths = [p for p in safe if not any(p[:i] in safe for i in range(1, len(p)) if p[i] == "/")]
    paths, more = look_fewer(paths, LOOK_PATHS, LOOK_SKIP + HIDE_NEVER + (LOOK_RUN,))
    return {"paths": paths, "whole": sorted(set(whole + more) & set(paths)), "units": units, "docker": docker,
            "logs": logs, "containers": containers}


def look_word(path):
    """One path as one word of a unit's property. systemd reads a property's value as words, with quotes: a name
    with a space, a quote or a backslash goes in double quotes, with its quotes and backslashes escaped, so that it
    stays one path and hides what it names, and never another path."""
    if LOOK_SAFE.fullmatch(path.removeprefix("-")):
        return path
    return '"' + path.replace("\\", "\\\\").replace('"', '\\"') + '"'


def look_box(unit, deny):
    """systemd-run's argv for the transient service of one look. Each property closes one way out of the box or
    back to a hidden path; look_check tries each of them on this host before the first look runs here."""
    props = [
        "DynamicUser=yes",                      # a user of its own, which owns nothing on this host
        "AmbientCapabilities=CAP_DAC_READ_SEARCH", "CapabilityBoundingSet=CAP_DAC_READ_SEARCH",    # it reads, no more
        "NoNewPrivileges=yes", "RestrictSUIDSGID=yes", "RestrictNamespaces=yes", "LockPersonality=yes",
        "ProtectSystem=strict", "ProtectHome=read-only",        # strict alone leaves /home open to a write
        # a user of its own brings a /tmp of its own on this host's disk, which a script could fill: both are closed,
        # and the script's room for its own files is 64 MiB of memory, which the unit's limit of memory counts
        "ReadOnlyPaths=/ /tmp /var/tmp", f"TemporaryFileSystem={LOOK_RUN}/tmp:size=64M,mode=1777",
        # no network, and no socket of any family: systemd-run takes no "none" for the families (systemd 255), so the
        # usual ones are refused by name and the calls that make or use a socket are refused all (@network-io)
        "PrivateNetwork=yes", "RestrictAddressFamilies=~AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET",
        "PrivateIPC=yes", "PrivateDevices=yes",
        "ProtectProc=invisible", "ProcSubset=pid", "ProtectKernelTunables=yes", "ProtectKernelModules=yes",
        "ProtectKernelLogs=yes", "ProtectControlGroups=yes", "ProtectClock=yes", "ProtectHostname=yes",
        "RestrictRealtime=yes", "KeyringMode=private", "UMask=0077",
        "SystemCallArchitectures=native", "SystemCallErrorNumber=EPERM",
        # with the right to read every file, a file's handle opens a hidden path again; io_uring makes a socket with
        # no socket call; the others are the ways into another process or another view of the files
        "SystemCallFilter=~@network-io open_by_handle_at name_to_handle_at io_uring_setup io_uring_enter io_uring_register "
        "ptrace process_vm_readv process_vm_writev mount umount2 pivot_root chroot setns unshare bpf perf_event_open "
        "keyctl add_key request_key kexec_load kexec_file_load init_module finit_module delete_module swapon swapoff "
        "reboot",
        "MemoryMax=512M", "MemorySwapMax=0", "TasksMax=64", "CPUWeight=20", "IOWeight=20",
        f"RuntimeMaxSec={LOOK_SECONDS}", "TimeoutStopSec=5", "KillMode=control-group", "SendSIGKILL=yes"]
    if deny["docker"]:
        props.append(f"TemporaryFileSystem={deny['docker']}:ro")
        props += [f"BindReadOnlyPaths=-{log}" for log in deny["logs"]]
    props += ["InaccessiblePaths=" + look_word("-" + p) for p in deny["paths"]]
    argv = ["systemd-run", "--pipe", "--wait", "--collect", "--quiet", "--unit", unit]
    for p in props:
        argv += ["--property", p]
    return argv + [f"--setenv={k}={v}" for k, v in ENV.items() if k != "DEBIAN_FRONTEND"] + \
        [f"--setenv=TMPDIR={LOOK_RUN}/tmp", "--setenv=LOOK_CONTAINERS=" + " ".join(deny["containers"])]


@contextlib.contextmanager
def look_lock(shared, wait=None):
    """A look's lock, shared, or a write's, alone. A file that is hidden by itself opens again when a program puts a
    new file in its place by a rename. Each form of this file that writes does it, or runs a program that can: so a
    write waits for the looks that run, and no look runs beside a write. A write takes the gate first and keeps it
    while it waits and while it runs, so that looks that overlap cannot keep it waiting for longer than one of them
    runs; a look only passes the gate. wait: the seconds that a look waits for a write that runs before it is
    refused, so that a long write leaves no look hanging with no word."""
    os.makedirs(os.path.dirname(P(LOOK_LOCK)) or "/", exist_ok=True)
    with open(P(LOOK_GATE), "a") as gate, open(P(LOOK_LOCK), "a") as lock:
        if shared and wait is not None:
            end = time.monotonic() + wait
            for held in (gate, lock):
                while True:
                    try:
                        fcntl.flock(held, fcntl.LOCK_SH | fcntl.LOCK_NB)
                        break
                    except OSError:
                        if time.monotonic() > end:
                            raise Refused("a form of the door writes on this host now, and no look runs beside a "
                                          "write: send the same look again when that call has ended") from None
                        time.sleep(0.2)
        else:
            fcntl.flock(gate, fcntl.LOCK_SH if shared else fcntl.LOCK_EX)
            fcntl.flock(lock, fcntl.LOCK_SH if shared else fcntl.LOCK_EX)
        if shared:
            fcntl.flock(gate, fcntl.LOCK_UN)
        yield


LOOK_HELD = threading.local()       # how deep this thread is inside look_writes: the lock is taken once
# The forms that hold the looks' lock for all of their run, and not only for a rename of this file's own: each runs
# a program that this file did not write and that can put a new file in the place of one that a look hides by
# itself. passwd and useradd do it with /etc/shadow, a package's install with a file of /etc, and the agent's own
# command or script with any file. The other forms put a file in its place only through replace, place and file,
# which take the lock themselves, and the fixed commands that they run (a restart, a certificate's renewal, a log's
# rotation, a prune) replace no file that a look hides by itself. So a look delays none of them longer than its own
# rename: the timer's cancel, which the door sends after a script, waits for no look.
LOOK_WRITERS = frozenset(("exec", "script", "run", "passwd-lock", "app-new", "install", "purge", "upgrade",
                          "tailscale-upgrade", "pro-attach"))


@contextlib.contextmanager
def look_writes():
    """Around each write of this file that puts a file in its place by a rename, and around the temporary file that
    it makes for it: alone, when no look runs (look_lock, look_quiet). A write inside another one takes the lock no
    second time, so that self-update waits one time for all of its files."""
    depth = getattr(LOOK_HELD, "depth", 0)
    if depth:
        LOOK_HELD.depth = depth + 1
        try:
            yield
        finally:
            LOOK_HELD.depth = depth
        return
    with look_lock(shared=False):
        look_quiet()
        LOOK_HELD.depth = 1
        try:
            yield
        finally:
            LOOK_HELD.depth = 0


@contextlib.contextmanager
def look_away(seconds):
    """For the rollback timer's restore, which puts files back as new files: the looks' lock, alone, when it comes
    within `seconds`, and no lock after that. The restore never waits for a form that writes, which can be the very
    script that the countdown guards and which keeps looks out by itself; a look ends within its own limit."""
    os.makedirs(os.path.dirname(P(LOOK_LOCK)) or "/", exist_ok=True)
    with open(P(LOOK_GATE), "a") as gate, open(P(LOOK_LOCK), "a") as lock:
        end = time.monotonic() + seconds
        for held in (gate, lock):
            while True:
                try:
                    fcntl.flock(held, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except OSError:
                    if time.monotonic() > end:
                        break
                    time.sleep(0.5)
        look_quiet()            # a look that lost its ops-root: to its unit's own limit at the most
        yield


def look_quiet():
    """Under a write's lock: wait until no look can still run. A look whose ops-root ended (the door's session went
    away) lost its lock and runs on, to its unit's own limit at the most: its mark says since when."""
    while True:
        try:
            marks = [os.path.join(P(LOOK_RUN), n) for n in os.listdir(P(LOOK_RUN)) if n.endswith(".run")]
        except OSError:
            return
        ages = []
        for mark in marks:
            with contextlib.suppress(OSError):
                ages.append(time.time() - os.stat(mark).st_mtime)
        # a mark from before a look can still run, by this host's clock; one far in the future is a clock that
        # went back, and it holds no write
        if not any(abs(age) < LOOK_SECONDS + 10 for age in ages):
            return
        time.sleep(1)


def look_clear():
    """Refused while a program that this file started still runs with no ops-root of its own: a script or a command
    whose call ended before it (the door's session went away, or its time was over), a package's install that goes
    on, the rollback timer's restore. Such a unit holds no lock, and it can put a new file in the place of one that
    a look hides by itself."""
    _, said = run(["systemctl", "list-units", "--type=service", "--no-legend", "--plain",
                   "--state=active,activating,deactivating", "ops-root-*"], timeout=30)
    units = [line.split()[0] for line in said.splitlines() if line.split()[:1] and
             line.split()[0].startswith("ops-root-") and line.split()[0].endswith(".service")]
    units = [u for u in units if not u.startswith(LOOK_UNIT) and u != BOOT_UNIT]
    if units:
        raise Refused(f"a program that the door started still runs on this host ({units[0]}), and no look runs "
                      f"beside it: send the same look again when it has ended")


def look_run(script, deny=None):
    """(status, output, deny) of one script in the box, under a look's lock."""
    with look_lock(shared=True, wait=LOOK_WAIT):
        look_clear()
        deny = deny or look_deny()
        unit = f"{LOOK_UNIT}{os.getpid()}"
        os.makedirs(P(LOOK_RUN) + "/tmp", mode=0o755, exist_ok=True)      # where the box puts the script's own room
        os.chmod(P(LOOK_RUN), 0o711)
        for name in os.listdir(P(LOOK_RUN)):        # what a look left whose ops-root ended before it: long over now
            old = os.path.join(P(LOOK_RUN), name)
            with contextlib.suppress(OSError):
                if name.endswith((".sh", ".run")) and time.time() - os.lstat(old).st_mtime > 4 * LOOK_SECONDS:
                    os.remove(old)
        path, mark = f"{LOOK_RUN}/{unit}.sh", f"{LOOK_RUN}/{unit}.run"
        try:
            for name, data in ((path, script), (mark, b"")):
                with contextlib.suppress(FileNotFoundError):
                    os.remove(P(name))
                with open(os.open(P(name), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644), "wb") as f:
                    f.write(data)
            try:
                r = subprocess.run(look_box(unit, deny) + ["--", "/bin/bash", path], stdin=subprocess.DEVNULL,
                                   stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=LOOK_SECONDS + 60,
                                   env=dict(ENV))
                status, out = r.returncode, r.stdout
            except FileNotFoundError:
                status, out = 127, b"systemd-run is not on this host"
            except subprocess.TimeoutExpired as e:
                status, out = 124, e.stdout or b""
            return status, out[-LOOK_OUT * 4:].decode("utf-8", "replace")[-LOOK_OUT:], deny
        finally:
            for name in (path, mark):
                with contextlib.suppress(OSError):
                    os.remove(P(name))


