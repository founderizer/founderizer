class Refused(Exception):
    """A form that this file does not run: the door's answer is this one line."""


class Failed(Exception):
    """A form that ran and failed."""


def P(path):
    return ROOT + path


def run(argv, stdin=None, timeout=900, env=None):
    """(status, output): one program with the fixed environment, its output and errors together, cut to OUT_MAX.
    stdin is bytes, or an open file that the program reads as it is."""
    stream = stdin if hasattr(stdin, "fileno") else None
    try:
        r = subprocess.run(argv, input=None if stream else stdin, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           timeout=timeout, env=dict(ENV, **(env or {})),
                           stdin=stream or (None if stdin is not None else subprocess.DEVNULL))
    except FileNotFoundError:
        return 127, f"{argv[0]} is not on this host"
    except subprocess.TimeoutExpired:
        return 124, f"{os.path.basename(argv[0])} took longer than {timeout} seconds"
    return r.returncode, r.stdout[-OUT_MAX:].decode("utf-8", "replace")


def read(path, default=""):
    try:
        with open(P(path), encoding="utf-8") as f:
            return f.read()
    except OSError:
        return default


def mode():
    """fix or rule-only. A missing or unknown mode file is rule-only: the strict reading."""
    found = read(MODE_FILE).strip()
    return found if found in ("fix", "rule-only") else "rule-only"


# ---------------------------------------------------------------- the forms
#
# Each form: its kind (rule: code passes it; own: the agent's own call, which runs only on a host in fix mode; refused
# never comes here), whether it writes, its window class (the door refuses a write of that class inside a window, DevOps
# plan section 4) and whether it is reboot-class (one at a time in each business). check() turns the arguments into the
# form's own, or raises Refused; run() does it.

FORMS = {}


def form(name, kind="rule", write=True, window=None, reboot=False, help=""):
    def put(f):
        FORMS[name] = {"name": name, "kind": kind, "write": write, "window": window, "reboot": reboot, "run": f,
                       "help": help}
        return f
    return put


def unit_name(text, kinds=("service",)):
    """A systemd unit of one of these kinds: a bare name is a service. Never an option, a path or a target."""
    if not isinstance(text, str) or not UNIT.fullmatch(text) or ".." in text:
        raise Refused(f"{text!r} is not a unit name")
    suffix = text.rsplit(".", 1)[1] if "." in text else None
    if suffix not in kinds:
        if suffix in ("target", "mount", "automount", "swap", "path", "slice", "scope", "device", "socket", "timer",
                      "service"):
            raise Refused(f"{text} is a .{suffix} unit, and this form takes a {' or '.join(kinds)}")
        text += ".service"
    return text


def no_args(args, name):
    if args:
        raise Refused(f"{name} takes no arguments")
    return []


def one(args, name, what):
    if len(args) != 1:
        raise Refused(f"{name} takes one argument: {what}")
    return args[0]


def systemctl(*words):
    return run(["systemctl", "--no-pager", "--no-ask-password", *words])


def check_args(op, args):
    """The arguments of one form, checked; Refused with the reason otherwise. The door calls this with the same
    table before it asks a host, and this file calls it again on the host."""
    if op not in FORMS:
        raise Refused(f"{op!r} is no form of a host; `help` lists them")
    if not isinstance(args, list) or len(args) > ARGS_MAX or \
            any(not isinstance(a, str) or len(a) > ARG_MAX or "\0" in a or "\n" in a for a in args):
        raise Refused("the arguments must be at most 64 lines of text")
    return CHECKS.get(op, lambda a: no_args(a, op))(args)


def check_unit(args, kinds=("service",), name="this form"):
    unit = unit_name(one(args, name, "a unit"), kinds)
    if unit == SSHD_UNIT:
        raise Refused("the door's own sshd is not a unit of this form")
    if unit == BOOT_UNIT:           # its start waits for the host's lock, which this form holds
        raise Refused("the rollback's boot unit is ops-root's own, not a unit of this form")
    return [unit]


def check_rollback(args):
    app = one(args, "rollback", "the app")
    if not APP.fullmatch(app):
        raise Refused(f"{app!r} is not an app name")
    return [app]


def check_runner(args, name):
    runner = one(args, name, "the runner")
    if not RUNNER.fullmatch(runner):
        raise Refused(f"{runner!r} is not a runner name")
    return [runner]


def check_grow(args, name="grow-pool"):
    size = one(args, name, "the GiB to add")
    if not re.fullmatch(r"[1-9][0-9]{0,2}", size) or int(size) > GROW_MAX:
        raise Refused(f"{name} adds 1 to {GROW_MAX} GiB at a time")
    return [size]


def check_user(args):
    user = one(args, "passwd-lock", "the user")
    if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", user) or user in ("root", "ops-agent"):
        raise Refused(f"{user!r} is not a user whose password the door locks")
    return [user]


def check_purge(args):
    if not args or len(args) > 20:
        raise Refused("purge takes 1 to 20 package names")
    for a in args:
        if not re.fullmatch(r"[a-z0-9][a-z0-9+.-]{0,99}", a):
            raise Refused(f"{a!r} is not a package name: no version, pattern or option")
    return list(args)


def check_paths(args, name, n):
    if len(args) != n or any(not a.startswith("/") or "\0" in a for a in args):
        raise Refused(f"{name} takes {n} absolute paths")
    return [os.path.normpath(a) for a in args]


def check_timer(args):
    word = one(args, "timer", "arm, cancel or status")
    if word not in ("arm", "cancel", "status"):
        raise Refused("timer takes arm, cancel or status")
    return [word]


def check_exec(args):
    """An exec command: an argv with no shell. Never a shell, an interpreter or a program that runs another one,
    never an option that runs one, and never a write to a protected path."""
    if not args:
        raise Refused("exec needs a command")
    program = os.path.basename(args[0])
    if program in REFUSED_PROGRAMS or re.fullmatch(r"(python|perl|ruby|php|lua|pypy|node)[0-9.]*", program):
        raise Refused(f"{program} is a shell, an interpreter or a program that runs others: never through the door")
    if any(a in REFUSED_ARGS or a.startswith("--exec") for a in args[1:]):
        raise Refused("an option that runs a command is never passed")
    if program == "dpkg" and (len(args) < 2 or args[1] not in ("--configure", "--audit", "-l", "-L", "-s", "-S")):
        raise Refused("dpkg runs here only to --configure, --audit, -l, -L, -s and -S: a package comes by install")
    if program == "find" and any(a == "-delete" or a.startswith("-fprint") for a in args[1:]):
        raise Refused("find runs here without -delete and without -fprint")
    if program == "nginx" and any(a in ("-T", "-c", "-g", "-p") or a.startswith(("-T", "-c", "-g", "-p"))
                                   for a in args[1:]):
        raise Refused("nginx runs here without -T, -c, -g and -p")
    for a in args[1:]:
        path = a.split("=", 1)[1] if a.startswith("-") and "=" in a else a
        if "/proc/" in path and re.search(r"/proc/[^/]+/(environ|mem|maps|fd|root|cwd|cmdline|auxv)|/proc/kcore", path):
            raise Refused("a process's environment, memory and files are never read")
        if path.startswith("/") and protected(path):
            raise Refused(f"{path} is protected on this host")
        if path.startswith("/") and any(path == h or path.startswith(h.rstrip("/") + "/") for h in hidden_paths()):
            raise Refused(f"{path} is an app tree or a secret path, which no exec command reads")
    return list(args)


def check_install(args):
    if not args or len(args) > 20:
        raise Refused("install takes 1 to 20 package names")
    for a in args:
        if not PACKAGE.fullmatch(a):
            raise Refused(f"{a!r} is not a package name: a package path or an option is never installed")
    return list(args)


def check_file(args):
    """file <path> <mode> <owner>[:<group>]: the bytes come on stdin with the request's sha256."""
    if len(args) != 3:
        raise Refused("file takes the path, the mode (like 0644) and the owner (like root or root:adm)")
    path, mode_text, owner = args
    if not path.startswith("/") or os.path.normpath(path) != path or path.endswith("/"):
        raise Refused(f"{path!r} is not a normal absolute path")
    if not re.fullmatch(r"0?[0-7]{3}", mode_text) or int(mode_text, 8) & 0o7000:
        raise Refused("the mode is three octal digits, with no setuid, setgid or sticky bit")
    if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}(:[a-z_][a-z0-9_-]{0,31})?", owner):
        raise Refused("the owner is a user, or user:group")
    if protected(path):
        raise Refused(f"{path} is protected: no file install writes it")
    return [path, mode_text, owner]


def protected(path):
    """True when the path, or where it really leads, is one that no install and no exec command writes."""
    names = {os.path.normpath(path)}
    with contextlib.suppress(OSError):
        names.add(os.path.realpath(P(path))[len(ROOT):] if ROOT else os.path.realpath(path))
    for name in names:
        base = os.path.basename(name)
        if base.startswith("authorized_keys"):
            return True
        for p in PROTECTED:
            if name == p.rstrip("/") or (p.endswith("/") and name.startswith(p)):
                return True
    return False


