@form("grow-file", help=f"grow the runners' build file from free space, at most {GROW_MAX} GiB at a time: a sparse "
                        "ext4 file on a loop device, online")
def do_grow_file(req, data):
    """truncate, losetup --set-capacity and resize2fs, as the owner grew it by hand. The file is sparse, so the file
    system that holds it must keep GROW_KEEP GiB free beyond all that the file may still take: a full build file
    stops the runners, and a full file system under it stops the host."""
    path = read(BUILD_FILE).strip()
    if not path.startswith("/") or os.path.normpath(path) != path or protected(path):
        raise Refused("this host names no build file")
    try:
        st = os.stat(P(path))
    except OSError:
        raise Refused(f"{path} is not on this host") from None
    if not stat.S_ISREG(st.st_mode):
        raise Refused(f"{path} is not a file")
    status, out = run(["losetup", "--associated", path])
    loops = re.findall(r"^(/dev/loop[0-9]{1,4}):", out, re.M)
    if status != 0 or len(loops) != 1:
        raise Refused(f"{path} is on no one loop device")
    status, out = run(["findmnt", "--noheadings", "--output", "FSTYPE", "--source", loops[0]])
    if status != 0 or out.split()[:1] != ["ext4"]:
        raise Refused(f"{loops[0]} is no mounted ext4 file system: only that grows online")
    new = st.st_size + int(req["args"][0]) * GIB
    held = os.statvfs(os.path.dirname(P(path)))
    free, room = held.f_bavail * held.f_frsize, new - st.st_blocks * 512
    if room + GROW_KEEP * GIB > free:
        raise Refused(f"the file could then take {room / GIB:.0f} GiB more, and its file system has "
                      f"{free / GIB:.0f} GiB free: it keeps {GROW_KEEP} GiB beyond that")
    os.truncate(P(path), new)
    checked(run(["losetup", "--set-capacity", loops[0]]), None)
    checked(run(["resize2fs", loops[0]], timeout=3600), None)
    return f"{path} grew to {new / GIB:.0f} GiB, and its file system with it"


