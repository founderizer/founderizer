@form("drop", help="delete a file that same or covers said yes for, while it is unchanged and the other file still "
                   "holds it")
def do_drop(req, data):
    """The delete checks again what the yes said, against the other file as it is now: a yes is old by the time of
    the drop, and a delete must never take the last copy of anything."""
    path = req["args"][0]
    yes = json.loads(read(STATE + "/yes.json", "{}") or "{}")
    entry = yes.get(path)
    digest = file_digest(path) if entry and plain(path) else None      # only a plain file with a yes is read
    if isinstance(entry, str) and entry == digest:      # an older ops-root kept the digest alone
        raise Refused(f"{path} has its yes from an older ops-root, which kept no name of the other file: ask same or "
                      f"covers again")
    other, said = (entry.get("other"), entry.get("form")) if isinstance(entry, dict) else (None, None)
    if digest is None or not isinstance(other, str) or said not in ("same", "covers") or \
            entry.get("digest") != digest:
        raise Refused(f"{path} had no yes from same or covers in its present form")
    for p in (path, other):
        guarded(p, "drop")
    apart(path, other, "drop")
    if not (file_digest(other) == digest if said == "same" else covered(path, other)):
        raise Refused(f"{other} no longer holds what {path} holds: nothing was deleted, ask {said} again")
    os.remove(P(path))
    yes.pop(path, None)
    write_state("yes.json", json.dumps(yes))
    return f"{path} deleted"


